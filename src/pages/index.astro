---
import Layout from '../layouts/Layout.astro';
import Landing from '../components/Landing.astro';
import { DEFAULT_PAYPAL_URL } from '../const';

const user = Astro.locals.user;
const paypalUrl = import.meta.env.DONATIONS_ENABLED !== 'false'
  ? import.meta.env.PAYPAL_URL || DEFAULT_PAYPAL_URL
  : '';
---

<Layout
  title="Nexo | Todo lo tuyo, en un solo enlace"
  description="Crea gratis una pagina personal para compartir tus redes, proyectos y enlaces desde una sola URL."
>
  <Landing user={user} paypalUrl={paypalUrl} />
</Layout>
