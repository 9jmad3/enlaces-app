---
import Layout from '../../layouts/Layout.astro';
import { getAdminOverview } from '../../lib/admin.js';
import { getModerationDashboard, isAdmin, REPORT_REASONS } from '../../lib/moderation.js';

export const prerender = false;

type ReportReason = keyof typeof REPORT_REASONS;
type ReportStatus = 'pending' | 'reviewed' | 'dismissed' | 'actioned';
interface ModerationReport {
  id: string;
  reason: ReportReason;
  details: string;
  reporter_email: string | null;
  status: ReportStatus;
  admin_note: string;
  public_reason: string;
  receipt_sent_at: string | null;
  created_at: string;
  slug: string;
  display_name: string;
  suspended_at: string | null;
  suspension_reason: string | null;
  owner_email: string;
  latest_action: 'review' | 'dismiss' | 'suspend' | 'restore' | null;
  reporter_notified_at: string | null;
  owner_notified_at: string | null;
  reporter_notification_error: string | null;
  owner_notification_error: string | null;
}

interface AdminMetrics {
  users_total: number;
  users_verified: number;
  users_last_7_days: number;
  users_last_30_days: number;
  profiles_total: number;
  profiles_published: number;
  profiles_suspended: number;
  links_active: number;
}

interface RegistrationMetric {
  day: string;
  registrations: number;
}

interface TemplateMetric {
  template_id: string;
  profiles: number;
}

interface AdminAccount {
  id: string;
  email: string;
  email_verified_at: string | null;
  pending_email: string | null;
  created_at: string;
  slug: string | null;
  display_name: string | null;
  template_id: string | null;
  published: boolean | null;
  suspended_at: string | null;
  updated_at: string | null;
  links: number;
  reports: number;
}

interface AdminOverview {
  metrics: AdminMetrics;
  registrations: RegistrationMetric[];
  templates: TemplateMetric[];
  users: AdminAccount[];
  directory: {
    search: string;
    page: number;
    pageSize: number;
    totalUsers: number;
    totalPages: number;
  };
}

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/admin');
if (!isAdmin(user)) return new Response('No encontrado', { status: 404 });

const search = Astro.url.searchParams.get('q') || '';
const requestedPage = Astro.url.searchParams.get('page') || '1';
const [dashboard, rawOverview] = await Promise.all([
  getModerationDashboard(),
  getAdminOverview({ search, page: Number.parseInt(requestedPage, 10) || 1 }),
]);
const overview = rawOverview as AdminOverview;
const reports = dashboard.reports as ModerationReport[];
const counts = dashboard.counts;
const metrics = overview.metrics;
const registrations = overview.registrations;
const templates = overview.templates;
const directory = overview.directory;
const adminUsers = overview.users;
const maxRegistrations = Math.max(1, ...registrations.map((item) => item.registrations));
const totalTemplateProfiles = Math.max(
  1,
  templates.reduce((total, item) => total + item.profiles, 0),
);
const templateLabels = {
  studio: 'Studio',
  pulse: 'Pulse',
  aura: 'Aura',
  frame: 'Frame',
};
const dateFormatter = new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'short' });
const dateTimeFormatter = new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' });
const pageHref = (page: number) => {
  const params = new URLSearchParams();
  if (directory.search) params.set('q', directory.search);
  params.set('page', String(page));
  return `/admin?${params}`;
};
const updated = Astro.url.searchParams.has('updated');
const error = Astro.url.searchParams.has('error');
const limited = Astro.url.searchParams.has('limited');
const notificationError = Astro.url.searchParams.has('notificationError');
const explanationRequired = Astro.url.searchParams.has('explanationRequired');
const statusLabels = {
  pending: 'Pendiente',
  reviewed: 'Revisada',
  dismissed: 'Descartada',
  actioned: 'Actuada',
};
---

<Layout
  title="Administración | Trazli"
  description="Panel privado de administración de Trazli."
  noindex
>
  <header class="admin-header">
    <a class="brand" href="/"><span>T</span>Trazli</a>
    <nav aria-label="Administración">
      <a href="#resumen">Resumen</a>
      <a href="#usuarios">Usuarios</a>
      <a href="#moderacion">Moderación</a>
      <a href="/app">Mi panel</a>
    </nav>
  </header>

  <main class="moderation">
    <div class="moderation__heading">
      <div>
        <p class="eyebrow">Panel privado</p>
        <h1>Todo Trazli,<br />de un vistazo.</h1>
      </div>
      <p>Consulta el crecimiento, revisa usuarios y gestiona las denuncias desde un único lugar.</p>
    </div>

    {updated && <p class="notice notice--success" role="status">Acción guardada.</p>}
    {error && <p class="notice" role="alert">No se pudo aplicar la acción.</p>}
    {limited && <p class="notice" role="alert">Demasiadas acciones. Espera antes de continuar.</p>}
    {notificationError && (
      <p class="notice" role="alert">
        La decisión se ha guardado, pero uno de los correos ha fallado. El detalle aparece en la denuncia para que puedas reintentarlo.
      </p>
    )}
    {explanationRequired && (
      <p class="notice" role="alert">
        Escribe una explicación pública de al menos 10 caracteres antes de cerrar el caso.
      </p>
    )}

    <section class="stats" id="resumen" aria-label="Resumen de Trazli">
      <article class="stat stat--primary">
        <span>Usuarios</span>
        <strong>{metrics.users_total}</strong>
        <small>+{metrics.users_last_7_days} esta semana</small>
      </article>
      <article>
        <span>Perfiles publicados</span>
        <strong>{metrics.profiles_published}</strong>
        <small>de {metrics.profiles_total} perfiles</small>
      </article>
      <article>
        <span>Correos verificados</span>
        <strong>{metrics.users_verified}</strong>
        <small>{metrics.users_total ? Math.round((metrics.users_verified / metrics.users_total) * 100) : 0}% del total</small>
      </article>
      <article>
        <span>Enlaces activos</span>
        <strong>{metrics.links_active}</strong>
        <small>visibles públicamente</small>
      </article>
    </section>

    <section class="analytics" aria-label="Métricas">
      <article class="panel growth-panel">
        <div class="panel__heading">
          <div>
            <p class="section-kicker">Crecimiento</p>
            <h2>Altas en 14 días</h2>
          </div>
          <strong>+{metrics.users_last_30_days}</strong>
        </div>
        <div class="bars" aria-label="Registro de usuarios por día">
          {registrations.map((item) => {
            const height = Math.max(5, Math.round((item.registrations / maxRegistrations) * 100));
            return (
              <div class="bar" title={`${item.registrations} altas el ${dateFormatter.format(new Date(item.day))}`}>
                <span style={`--bar-height:${height}%`}>
                  {item.registrations > 0 && <b>{item.registrations}</b>}
                </span>
                <small>{dateFormatter.format(new Date(item.day)).replace('.', '')}</small>
              </div>
            );
          })}
        </div>
      </article>

      <article class="panel templates-panel">
        <div class="panel__heading">
          <div>
            <p class="section-kicker">Preferencias</p>
            <h2>Plantillas usadas</h2>
          </div>
        </div>
        <div class="template-metrics">
          {templates.length === 0 ? (
            <p class="panel-empty">Todavía no hay perfiles.</p>
          ) : templates.map((item) => {
            const percentage = Math.round((item.profiles / totalTemplateProfiles) * 100);
            return (
              <div>
                <span>
                  <i class={`template-dot template-dot--${item.template_id}`}></i>
                  {templateLabels[item.template_id as keyof typeof templateLabels] || item.template_id}
                </span>
                <strong>{item.profiles}</strong>
                <progress value={item.profiles} max={totalTemplateProfiles}>{percentage}%</progress>
                <small>{percentage}%</small>
              </div>
            );
          })}
        </div>
      </article>
    </section>

    <section class="users-section" id="usuarios">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Directorio</p>
          <h2>Usuarios</h2>
        </div>
        <form class="user-search" action="/admin" method="get">
          <label class="sr-only" for="user-search">Buscar usuario</label>
          <input
            id="user-search"
            name="q"
            type="search"
            value={directory.search}
            maxlength="80"
            placeholder="Correo, nombre o usuario..."
          />
          <button type="submit">Buscar</button>
          {directory.search && <a href="/admin#usuarios">Limpiar</a>}
        </form>
      </div>

      <div class="user-table-wrap">
        <table class="user-table">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Perfil</th>
              <th>Estado</th>
              <th>Actividad</th>
              <th>Alta</th>
              <th><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody>
            {adminUsers.length === 0 ? (
              <tr><td class="table-empty" colspan="6">No hay usuarios que coincidan con la búsqueda.</td></tr>
            ) : adminUsers.map((account) => (
              <tr>
                <td data-label="Usuario">
                  <strong>{account.email}</strong>
                  <small class:list={['email-state', { 'email-state--ok': account.email_verified_at }]}>
                    {account.email_verified_at ? 'Correo verificado' : 'Pendiente de verificar'}
                  </small>
                  {account.pending_email && <small>Cambio pendiente: {account.pending_email}</small>}
                </td>
                <td data-label="Perfil">
                  <strong>{account.display_name || 'Sin perfil'}</strong>
                  {account.slug && <small>@{account.slug} · {templateLabels[account.template_id as keyof typeof templateLabels] || account.template_id}</small>}
                </td>
                <td data-label="Estado">
                  {account.suspended_at ? (
                    <span class="account-status account-status--suspended">Oculto</span>
                  ) : account.published ? (
                    <span class="account-status account-status--published">Publicado</span>
                  ) : (
                    <span class="account-status">Borrador</span>
                  )}
                </td>
                <td data-label="Actividad">
                  <span class="activity-value">{account.links} enlaces</span>
                  <small>{account.reports} denuncias</small>
                </td>
                <td data-label="Alta">
                  <time datetime={account.created_at}>{dateTimeFormatter.format(new Date(account.created_at))}</time>
                </td>
                <td>
                  {account.slug && !account.suspended_at && (
                    <a class="table-action" href={`/${account.slug}`} target="_blank" aria-label={`Ver perfil de ${account.display_name}`}>Ver ↗</a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <p>
          {directory.totalUsers} {directory.totalUsers === 1 ? 'usuario' : 'usuarios'}
          {directory.search && <> para “{directory.search}”</>}
        </p>
        <div>
          {directory.page > 1 ? <a href={pageHref(directory.page - 1)}>← Anterior</a> : <span>← Anterior</span>}
          <b>{directory.page} / {directory.totalPages}</b>
          {directory.page < directory.totalPages ? <a href={pageHref(directory.page + 1)}>Siguiente →</a> : <span>Siguiente →</span>}
        </div>
      </div>
    </section>

    <section class="moderation-section" id="moderacion">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Contenido y seguridad</p>
          <h2>Moderación</h2>
        </div>
        <div class="moderation-summary" aria-label="Resumen de moderación">
          <span><strong>{counts.pending}</strong> pendientes</span>
          <span><strong>{counts.suspended}</strong> ocultos</span>
          <span><strong>{counts.total}</strong> totales</span>
        </div>
      </div>

      <div class="report-list">
      {reports.length === 0 ? (
        <div class="empty">
          <span aria-hidden="true">✓</span>
          <h2>No hay denuncias</h2>
          <p>Cuando llegue una, aparecerá aquí con toda la información necesaria.</p>
        </div>
      ) : reports.map((report) => (
        <article class:list={['report', { 'report--pending': report.status === 'pending' }]}>
          <div class="report__top">
            <div>
              <span class={`status status--${report.status}`}>{statusLabels[report.status]}</span>
              <h2>{REPORT_REASONS[report.reason]}</h2>
              <p>
                Perfil <a href={`/${report.slug}`} target="_blank">@{report.slug}</a>
                <span>·</span> {report.display_name}
              </p>
            </div>
            <time datetime={report.created_at}>
              {new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(report.created_at))}
            </time>
          </div>

          <dl class="report__details">
            <div><dt>Propietario</dt><dd>{report.owner_email}</dd></div>
            <div><dt>Contacto denunciante</dt><dd>{report.reporter_email || 'No facilitado'}</dd></div>
            <div class="report__message"><dt>Detalles</dt><dd>{report.details || 'Sin detalles adicionales.'}</dd></div>
            {report.admin_note && <div class="report__message"><dt>Última nota interna</dt><dd>{report.admin_note}</dd></div>}
            {report.public_reason && <div class="report__message"><dt>Explicación comunicada</dt><dd>{report.public_reason}</dd></div>}
          </dl>

          <div class="delivery" aria-label="Estado de las comunicaciones">
            <span class:list={{ 'delivery--sent': report.receipt_sent_at }}>
              Acuse: {!report.reporter_email ? 'sin correo' : report.receipt_sent_at ? 'enviado' : 'no enviado'}
            </span>
            {report.reporter_email && ['dismiss', 'suspend', 'restore'].includes(report.latest_action || '') && (
              <span class:list={{ 'delivery--sent': report.reporter_notified_at, 'delivery--error': report.reporter_notification_error }}>
                Denunciante: {report.reporter_notified_at ? 'notificado' : report.reporter_notification_error ? 'falló' : 'pendiente'}
              </span>
            )}
            {['suspend', 'restore'].includes(report.latest_action || '') && (
              <span class:list={{ 'delivery--sent': report.owner_notified_at, 'delivery--error': report.owner_notification_error }}>
                Propietario: {report.owner_notified_at ? 'notificado' : report.owner_notification_error ? 'falló' : 'pendiente'}
              </span>
            )}
          </div>
          {(report.reporter_notification_error || report.owner_notification_error) && (
            <p class="delivery-error">
              Error de correo: {report.reporter_notification_error || report.owner_notification_error}
            </p>
          )}

          {report.suspended_at && (
            <p class="suspended">
              Perfil oculto: {report.suspension_reason || 'Sin motivo interno indicado'}
            </p>
          )}

          <form class="moderation-form" action="/api/admin/reports" method="post">
            <input type="hidden" name="reportId" value={report.id} />
            <label>
              Explicación para las personas afectadas
              <textarea
                name="publicReason"
                maxlength="1000"
                placeholder="Explica qué se ha comprobado y por qué se toma esta decisión, sin incluir datos personales del denunciante."
              >{report.public_reason}</textarea>
              <small>Obligatoria para descartar, ocultar o restaurar. Se incluirá en los correos y será visible para el propietario.</small>
            </label>
            <label>
              Nota interna
              <textarea name="note" maxlength="1000" placeholder="Decisión, comprobaciones o motivo de la acción...">{report.admin_note}</textarea>
            </label>
            <div class="actions">
              <button name="action" value="review" type="submit">Marcar revisada</button>
              <button name="action" value="dismiss" type="submit">Descartar</button>
              {report.suspended_at ? (
                <button class="action--restore" name="action" value="restore" type="submit" data-confirm="¿Restaurar y volver a publicar este perfil?">Restaurar perfil</button>
              ) : (
                <button class="action--danger" name="action" value="suspend" type="submit" data-confirm="¿Ocultar este perfil de forma inmediata?">Ocultar perfil</button>
              )}
            </div>
          </form>
        </article>
      ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((button) => {
    button.addEventListener('click', (event) => {
      if (!window.confirm(button.dataset.confirm)) event.preventDefault();
    });
  });
</script>

<style>
  :global(body) { background: #f3f0e8; }
  .admin-header {
    display: flex;
    min-height: 4.5rem;
    padding: 0 4vw;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #d9d5ca;
    background: #fffdf8;
  }
  .brand { display: flex; align-items: center; gap: 0.55rem; color: #17201d; font-weight: 850; text-decoration: none; }
  .brand span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 0.55rem; background: #17201d; color: #ff7357; font-family: var(--font-display); }
  nav { display: flex; align-items: center; gap: 1.2rem; font-size: 0.78rem; }
  nav a { color: #53605b; text-underline-offset: 0.25rem; }
  nav a:last-child { padding-left: 1.2rem; border-left: 1px solid #d9d5ca; font-weight: 800; }
  .moderation { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 4rem 0; }
  .moderation__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .moderation__heading > p { max-width: 30rem; margin: 0 0 0.5rem; color: #65706c; line-height: 1.6; }
  .eyebrow { margin: 0 0 0.55rem; color: #e45136; font-size: 0.7rem; font-weight: 850; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { margin: 0; color: #17201d; font-family: var(--font-display); font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 620; letter-spacing: -0.06em; line-height: 0.86; }
  .notice { margin-top: 1.5rem; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 2.5rem 0; gap: 0.75rem; }
  .stats article { display: flex; min-height: 9rem; padding: 1.1rem; flex-direction: column; border: 1px solid #d9d5ca; border-radius: 1rem; background: #fffdf8; }
  .stats .stat--primary { border-color: #17201d; background: #17201d; color: #fffdf8; }
  .stats strong { margin: auto 0 0.15rem; color: #17201d; font-family: var(--font-display); font-size: 3rem; font-weight: 620; line-height: 0.9; }
  .stats .stat--primary strong { color: #fffdf8; }
  .stats span { color: #65706c; font-size: 0.72rem; font-weight: 800; }
  .stats .stat--primary span { color: #bfc8c4; }
  .stats small { color: #7a837f; font-size: 0.62rem; }
  .stats .stat--primary small { color: #aeb9b4; }
  .analytics { display: grid; grid-template-columns: 1.5fr 0.8fr; margin-bottom: 4rem; gap: 0.75rem; }
  .panel {
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid #d9d5ca;
    border-radius: 1.25rem;
    background: #fffdf8;
  }
  .panel__heading, .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; }
  .section-kicker { margin: 0 0 0.35rem; color: #e45136; font-size: 0.62rem; font-weight: 850; letter-spacing: 0.1em; text-transform: uppercase; }
  .panel h2, .section-heading h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.7rem); font-weight: 620; letter-spacing: -0.045em; line-height: 0.95; }
  .panel__heading > strong { color: #e45136; font-family: var(--font-display); font-size: 2.5rem; font-weight: 620; }
  .bars { display: grid; height: 12rem; margin-top: 1.8rem; grid-template-columns: repeat(14, 1fr); align-items: end; gap: clamp(0.2rem, 1vw, 0.55rem); }
  .bar { display: grid; height: 100%; min-width: 0; grid-template-rows: 1fr auto; align-items: end; gap: 0.45rem; text-align: center; }
  .bar > span {
    position: relative;
    display: block;
    width: 100%;
    height: var(--bar-height);
    min-height: 0.35rem;
    border-radius: 0.35rem 0.35rem 0.1rem 0.1rem;
    background: #b8ddd0;
  }
  .bar:nth-child(4n + 2) > span { background: #f2c84f; }
  .bar:nth-child(4n + 3) > span { background: #ef8069; }
  .bar:nth-child(4n) > span { background: #17201d; }
  .bar b { position: absolute; top: -1.15rem; left: 50%; color: #59645f; font-size: 0.55rem; transform: translateX(-50%); }
  .bar small { overflow: hidden; color: #8a928f; font-size: clamp(0.42rem, 0.8vw, 0.55rem); white-space: nowrap; }
  .template-metrics { display: grid; margin-top: 1.5rem; gap: 1.1rem; }
  .template-metrics > div {
    display: grid;
    grid-template-columns: minmax(5rem, 1fr) auto;
    align-items: center;
    gap: 0.35rem 0.7rem;
  }
  .template-metrics span { display: flex; min-width: 0; align-items: center; gap: 0.45rem; font-size: 0.75rem; font-weight: 800; }
  .template-metrics strong { font-size: 0.75rem; }
  .template-metrics progress { width: 100%; height: 0.42rem; overflow: hidden; border: 0; border-radius: 999px; background: #e5e2da; }
  .template-metrics progress::-webkit-progress-bar { border-radius: 999px; background: #e5e2da; }
  .template-metrics progress::-webkit-progress-value { border-radius: 999px; background: #17201d; }
  .template-metrics progress::-moz-progress-bar { border-radius: 999px; background: #17201d; }
  .template-metrics small { color: #7a837f; font-size: 0.58rem; }
  .template-dot { display: block; width: 0.65rem; height: 0.65rem; flex: 0 0 auto; border-radius: 0.18rem; background: #b8ddd0; }
  .template-dot--pulse { border-radius: 50%; background: #f2c84f; }
  .template-dot--aura { border-radius: 50%; background: #ef8069; box-shadow: 0 0 0 0.2rem #f8dcd6; }
  .template-dot--frame { border-radius: 0; background: #17201d; }
  .panel-empty { color: #65706c; font-size: 0.75rem; }
  .users-section, .moderation-section { scroll-margin-top: 1rem; }
  .users-section { margin-bottom: 4rem; }
  .user-search { display: flex; align-items: center; gap: 0.45rem; }
  .user-search input {
    width: min(18rem, 42vw);
    height: 2.65rem;
    padding: 0 0.8rem;
    border: 1px solid #cfcac0;
    border-radius: 0.7rem;
    background: #fffdf8;
    color: #17201d;
  }
  .user-search button, .user-search a {
    display: inline-flex;
    min-height: 2.65rem;
    padding: 0.55rem 0.8rem;
    align-items: center;
    border-radius: 0.7rem;
    font-size: 0.68rem;
    font-weight: 800;
  }
  .user-search button { border-color: #17201d; background: #17201d; color: white; }
  .user-search a { color: #65706c; }
