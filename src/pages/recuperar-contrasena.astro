---
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/AuthShell.astro';
import { isEmailDeliveryConfigured } from '../lib/email.js';

if (Astro.locals.user) return Astro.redirect('/app');
const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent');
const emailEnabled = isEmailDeliveryConfigured();
---

<Layout title="Recuperar contraseña | Trazli" description="Recupera el acceso a tu cuenta de Trazli.">
  <AuthShell
    title="Recupera tu espacio."
    intro="Escribe tu correo y, si existe una cuenta asociada, recibirás un enlace de recuperación."
    alternateText="¿Recuerdas tu contraseña?"
    alternateHref="/login"
    alternateLabel="Volver a entrar"
  >
    {!emailEnabled ? (
      <p class="notice" role="status">
        La recuperación por correo todavía no está disponible.
      </p>
    ) : sent ? (
      <div class="recovery-result">
        <p class="notice notice--success" role="status">
          Si existe una cuenta con ese correo, recibirás un enlace en unos minutos.
        </p>
        <a class="button" href="/login">Volver al acceso</a>
      </div>
    ) : (
      <form class="auth-form" action="/api/auth/forgot-password" method="post">
        {error && <p class="notice" role="alert">{error}</p>}
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <button class="button button--coral" type="submit">Enviar enlace de recuperación</button>
      </form>
    )}
  </AuthShell>
</Layout>

<style>
  .recovery-result { display: grid; gap: 1rem; }
  .recovery-result .button { width: fit-content; }
</style>
