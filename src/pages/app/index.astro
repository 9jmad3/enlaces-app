---
import Layout from '../../layouts/Layout.astro';
import LegalFooter from '../../components/LegalFooter.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { getSpotifyEmbedUrl, getYouTubeEmbedUrl } from '../../lib/media.js';
import { isAdmin } from '../../lib/moderation.js';
import { getEditableProfile } from '../../lib/profiles.js';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const profile = await getEditableProfile(user.id);
if (!profile) return Astro.redirect('/login');
const admin = isAdmin(user);

const links = Array.from({ length: 6 }, (_, index) => (
  profile.links[index] || { title: '', url: '', enabled: true, position: index, section_title: '' }
));
const socialProfiles = [
  { platform: 'instagram' as const, label: 'Instagram', field: 'instagram', url: profile.instagram_url || '', enabled: profile.instagram_enabled },
  { platform: 'tiktok' as const, label: 'TikTok', field: 'tiktok', url: profile.tiktok_url || '', enabled: profile.tiktok_enabled },
  { platform: 'youtube' as const, label: 'Canal de YouTube', field: 'youtubeSocial', url: profile.youtube_social_url || '', enabled: profile.youtube_social_enabled },
];
type EditorContentItem =
  | { kind: 'link'; index: number; link: typeof links[number]; position: number; defaultOrder: number }
  | { kind: 'spotify' | 'youtube'; position: number; defaultOrder: number };
const contentItems: EditorContentItem[] = [
  ...links.map((link, index): EditorContentItem => ({ kind: 'link', index, link, position: link.position ?? index, defaultOrder: index })),
  { kind: 'spotify' as const, position: profile.spotify_position ?? 6, defaultOrder: 6 },
  { kind: 'youtube' as const, position: profile.youtube_position ?? 7, defaultOrder: 7 },
].sort((first, second) => first.position - second.position || first.defaultOrder - second.defaultOrder);
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved');
const welcome = Astro.url.searchParams.get('welcome');
const verify = Astro.url.searchParams.get('verify');
const verified = Astro.url.searchParams.get('verified');
const verificationSent = Astro.url.searchParams.get('verificationSent');
const passwordReset = Astro.url.searchParams.get('passwordReset');
const profileStyle = `--preview-bg:${profile.background_color};--preview-accent:${profile.accent_color};--preview-text:${profile.text_color};--preview-avatar-x:${profile.avatar_position_x ?? 50}%;--preview-avatar-y:${profile.avatar_position_y ?? 20}%`;
const avatarStyle = `--avatar-x:${profile.avatar_position_x ?? 50}%;--avatar-y:${profile.avatar_position_y ?? 20}%`;
const mediaPreviewUrls = {
  spotify: getSpotifyEmbedUrl(profile.spotify_url),
  youtube: getYouTubeEmbedUrl(profile.youtube_url),
};
const iframeNoScroll = { scrolling: 'no' };
const getPreviewLinkIcon = (title: string, value: string) => {
  const label = title.toLowerCase();
  try {
    const hostname = new URL(value).hostname.replace(/^www\./, '').toLowerCase();
    if (hostname.includes('instagram.com') || label.includes('instagram')) return '◎';
    if (hostname.includes('tiktok.com') || label.includes('tiktok')) return '♪';
    if (hostname.includes('youtube.com') || hostname === 'youtu.be' || label.includes('youtube')) return '▶';
  } catch {
    // A generic web icon keeps the preview stable while the URL is incomplete.
  }
  return '⊙';
};
---

<Layout title="Mi panel | Trazli" description="Configura y publica tu página de Trazli." bodyClass="dashboard-body">
  <header class="app-header">
    <a class="brand" href="/"><span>T</span>Trazli</a>
    <div class="app-header__actions">
      {!profile.suspended_at && <a class="view-profile-link" href={`/${profile.slug}`} target="_blank">Ver mi página ↗</a>}
      {admin && <a href="/admin">Moderación</a>}
      <a href="/app/cuenta">Cuenta</a>
      <form action="/api/auth/logout" method="post">
        <button type="submit">Salir</button>
      </form>
    </div>
  </header>

  <main class="dashboard">
    <form class="editor" action="/api/profile/save" method="post" enctype="multipart/form-data">
      <div class="editor__heading">
        <p class="eyebrow">Tu página</p>
        <h1>Hazla tuya.</h1>
        <p>Cambia lo que necesites. Verás el resultado al momento.</p>
      </div>

      {error && <p class="notice" role="alert">{error}</p>}
      {saved && <p class="notice notice--success">Cambios guardados.</p>}
      {welcome && <p class="notice notice--success">Tu página ya existe. Ahora dale tu estilo.</p>}
      {verified && <p class="notice notice--success">Correo verificado. Ya puedes publicar tu página.</p>}
      {verificationSent && <p class="notice notice--success">Te hemos enviado un nuevo enlace de verificación.</p>}
      {passwordReset && <p class="notice notice--success">Contraseña actualizada y sesiones anteriores cerradas.</p>}
      {profile.suspended_at && (
        <p class="notice suspension-notice" role="alert">
          Tu perfil está oculto por moderación y no puede publicarse ahora.
          {profile.suspension_reason && <> Motivo: {profile.suspension_reason}</>}
          {' '}La decisión se basa en nuestras <a href="/condiciones#moderacion-suspension">condiciones de uso</a>.
          Si crees que se trata de un error, solicita una revisión escribiendo a <a href="mailto:hola@trazli.com">hola@trazli.com</a>.
        </p>
      )}

      {!user.email_verified_at && (
        <section class="verify-card">
          <div>
            <p class="eyebrow">Protege tu cuenta</p>
            <h2>Confirma tu correo</h2>
            <p>
              Hemos enviado un enlace a <strong>{user.email}</strong>. Confírmalo para poder
              publicar tu página.
            </p>
            {verify && <small>Si no lo encuentras, revisa la carpeta de spam.</small>}
          </div>
          <form action="/api/auth/resend-verification" method="post">
            <button class="button" type="submit">Reenviar correo</button>
          </form>
        </section>
      )}

      <section class="editor-card">
        <div class="section-title">
          <span>01</span>
          <div><h2>Lo esencial</h2><p>Cómo te presentas al mundo.</p></div>
        </div>
        <div class="fields-grid">
          <div class="field">
            <label for="displayName">Nombre</label>
            <input id="displayName" name="displayName" maxlength="60" value={profile.display_name} data-preview="name" required />
          </div>
          <div class="field">
            <label for="slug">Dirección</label>
            <div class="slug-input">
              <span>/</span>
              <input id="slug" name="slug" maxlength="30" value={profile.slug} data-preview="slug" required />
            </div>
            <small class="field__hint" data-slug-status></small>
          </div>
        </div>
        <div class="field">
          <label for="tagline">Frase corta</label>
          <input id="tagline" name="tagline" maxlength="100" value={profile.tagline} data-preview="tagline" />
        </div>
        <div class="field">
          <label for="bio">Sobre ti</label>
          <textarea id="bio" name="bio" maxlength="280" data-preview="bio">{profile.bio}</textarea>
          <small class="field__hint">Máximo 280 caracteres.</small>
        </div>
        <div class="social-editor">
          <div class="social-editor__heading">
            <strong>Redes sociales</strong>
            <span>Aparecerán como iconos justo debajo de tu descripción.</span>
          </div>
          <div class="social-editor__list">
            {socialProfiles.map((social) => (
              <div class={`social-row social-row--${social.platform}`}>
                <span class="social-row__icon"><SocialIcon platform={social.platform} /></span>
                <label for={`${social.field}Url`}>{social.label}</label>
                <input
                  id={`${social.field}Url`}
                  name={`${social.field}Url`}
                  type="text"
                  inputmode="url"
                  autocomplete="url"
                  value={social.url}
                  placeholder={social.platform === 'youtube' ? 'youtube.com/@tuusuario' : `${social.platform}.com/${social.platform === 'tiktok' ? '@' : ''}tuusuario`}
                  data-social-url={social.platform}
                />
                <label class="switch" title={`Mostrar ${social.label}`}>
                  <input name={`${social.field}Enabled`} type="checkbox" checked={social.enabled} data-social-enabled={social.platform} />
                  <span></span>
                </label>
              </div>
            ))}
          </div>
        </div>
        <div class="field">
          <span class="field__label">Foto</span>
          <div class="avatar-uploader" data-current-avatar={profile.avatar_url} style={avatarStyle}>
            <div class="avatar-uploader__preview" data-upload-preview>
              {profile.avatar_url
                ? <img class="avatar-live-image" src={profile.avatar_url} alt="" />
                : <b>{profile.display_name[0]?.toUpperCase()}</b>}
            </div>
            <div class="avatar-uploader__content">
              <input
                class="avatar-uploader__input"
                id="avatar"
                name="avatar"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                data-avatar-input
              />
              <div class="avatar-uploader__action">
                <label class="avatar-uploader__button" for="avatar">Elegir foto</label>
                <span data-avatar-file-name>Ningún archivo seleccionado</span>
              </div>
              <small class="field__hint">JPG, PNG o WebP. Máximo 12 MB. La optimizaremos automáticamente.</small>
              {profile.avatar_url && (
                <label class="remove-avatar">
                  <input name="removeAvatar" type="checkbox" data-remove-avatar />
                  <span class="remove-avatar__box" aria-hidden="true"></span>
                  <span>Quitar la foto actual</span>
                </label>
              )}
            </div>
            <input type="hidden" name="avatarPositionX" value={profile.avatar_position_x ?? 50} />
            <input type="hidden" name="avatarPositionY" value={profile.avatar_position_y ?? 20} />
            <div class="avatar-position" data-avatar-position-controls hidden={!profile.avatar_url}>
              <div class="avatar-position__heading">
                <strong>Vista previa de la foto</strong>
                <span>Comprueba cómo se verá en cada plantilla antes de guardar.</span>
              </div>
              <div class="avatar-crops" aria-label="Vista previa del encuadre">
                <figure class="avatar-crop avatar-crop--portrait">
                  <div data-avatar-crop-preview>
                    {profile.avatar_url ? <img class="avatar-live-image" src={profile.avatar_url} alt="" /> : <b>{profile.display_name[0]?.toUpperCase()}</b>}
                  </div>
                  <figcaption>Studio</figcaption>
                </figure>
                <figure class="avatar-crop avatar-crop--circle">
                  <div data-avatar-crop-preview>
                    {profile.avatar_url ? <img class="avatar-live-image" src={profile.avatar_url} alt="" /> : <b>{profile.display_name[0]?.toUpperCase()}</b>}
                  </div>
                  <figcaption>Pulse · Aura</figcaption>
                </figure>
                <figure class="avatar-crop avatar-crop--frame">
                  <div data-avatar-crop-preview>
                    {profile.avatar_url ? <img class="avatar-live-image" src={profile.avatar_url} alt="" /> : <b>{profile.display_name[0]?.toUpperCase()}</b>}
                  </div>
                  <figcaption>Frame</figcaption>
                </figure>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="editor-card">
        <div class="section-title">
          <span>02</span>
          <div><h2>Diseño</h2><p>Cuatro personalidades, los colores que quieras.</p></div>
        </div>
        <div class="template-options">
          <label class="template-option">
            <input type="radio" name="templateId" value="studio" checked={profile.template_id === 'studio'} />
            <span class="template-preview template-preview--studio"><i></i><b>Studio</b></span>
            <small>Editorial y serena</small>
          </label>
          <label class="template-option">
            <input type="radio" name="templateId" value="pulse" checked={profile.template_id === 'pulse'} />
            <span class="template-preview template-preview--pulse"><i></i><b>Pulse</b></span>
            <small>Gráfica y directa</small>
          </label>
          <label class="template-option">
            <input type="radio" name="templateId" value="aura" checked={profile.template_id === 'aura'} />
            <span class="template-preview template-preview--aura"><i></i><b>Aura</b></span>
            <small>Luminosa y envolvente</small>
          </label>
          <label class="template-option">
            <input type="radio" name="templateId" value="frame" checked={profile.template_id === 'frame'} />
            <span class="template-preview template-preview--frame"><i></i><b>Frame</b></span>
            <small>Fluida y dinámica</small>
          </label>
        </div>
        <div class="color-options">
          <label>
            <span>Fondo</span>
            <input type="color" name="backgroundColor" value={profile.background_color} data-color="bg" />
          </label>
          <label>
            <span>Acento</span>
            <input type="color" name="accentColor" value={profile.accent_color} data-color="accent" />
          </label>
          <label>
            <span>Texto</span>
            <input type="color" name="textColor" value={profile.text_color} data-color="text" />
          </label>
        </div>
      </section>

      <section class="editor-card">
        <div class="section-title">
          <span>03</span>
          <div><h2>Tu contenido</h2><p>Ordena enlaces, música y vídeo como quieras.</p></div>
        </div>
        <div class="sections-guide">
          <span aria-hidden="true">Aa</span>
          <p><strong>Las secciones son opcionales.</strong> Añade una solo en el primer enlace de cada grupo. Los enlaces siguientes quedarán debajo hasta que empiece otra sección.</p>
        </div>
        <div class="links-editor">
          {contentItems.map((item) => item.kind === 'link' ? (
              <article class="link-row" data-content-row={`link-${item.index}`} data-link-row={item.index}>
                <button class="drag" type="button" draggable="true" aria-label={`Arrastrar enlace ${item.index + 1}`} title="Arrastrar para reordenar">··</button>
                <input type="hidden" name={`linkPosition${item.index}`} value={item.position} data-content-position />
                <div class="link-fields">
                  <div class:list={['link-section-control', { 'link-section-control--open': Boolean(item.link.section_title) }]} data-section-control>
                    <button
                      class="link-section-toggle"
                      type="button"
                      aria-expanded={Boolean(item.link.section_title)}
                      data-section-toggle
                    >
                      <span><b>Sección</b><small>Empieza un grupo antes de este enlace</small></span>
                      <strong data-section-action>{item.link.section_title ? 'Quitar' : '+ Empezar aquí'}</strong>
                    </button>
                    <div class="link-section-field" hidden={!item.link.section_title} data-section-field>
                      <label for={`linkSection${item.index}`}>Nombre de la sección</label>
                      <input
                        id={`linkSection${item.index}`}
                        name={`linkSection${item.index}`}
                        value={item.link.section_title || ''}
                        maxlength="80"
                        placeholder="Ej. Mis proyectos"
                        data-link-section={item.index}
                      />
                    </div>
                  </div>
                  <input
                    name={`linkTitle${item.index}`}
                    value={item.link.title}
                    maxlength="60"
                    placeholder="Título del enlace"
                    aria-label={`Título del enlace ${item.index + 1}`}
                    data-link-title={item.index}
                  />
                  <input
                    name={`linkUrl${item.index}`}
                    value={item.link.url}
                    type="text"
                    inputmode="url"
                    autocomplete="url"
                    placeholder="https://tu-enlace.com"
                    aria-label={`URL del enlace ${item.index + 1}`}
                    data-link-url={item.index}
                  />
                </div>
                <label class="switch" title="Mostrar enlace">
                  <input name={`linkEnabled${item.index}`} type="checkbox" checked={item.link.enabled} data-link-enabled={item.index} />
                  <span></span>
                </label>
                <div class="order-actions">
                  <button type="button" data-move="up" aria-label={`Subir enlace ${item.index + 1}`}>↑</button>
                  <button type="button" data-move="down" aria-label={`Bajar enlace ${item.index + 1}`}>↓</button>
                </div>
              </article>
            ) : (
              <article class:list={['link-row', 'link-row--media', `link-row--${item.kind}`]} data-content-row={item.kind} data-media-row={item.kind}>
                <button class="drag" type="button" draggable="true" aria-label={`Arrastrar ${item.kind === 'spotify' ? 'Spotify' : 'YouTube'}`} title="Arrastrar para reordenar">··</button>
                <input type="hidden" name={`${item.kind}Position`} value={item.position} data-content-position />
                <div class="media-link-fields">
                  <span class="media-editor__icon" aria-hidden="true">{item.kind === 'spotify' ? '♫' : '▶'}</span>
                  <div>
                    <strong>{item.kind === 'spotify' ? 'Spotify' : 'YouTube'}</strong>
                    <input
                      id={`${item.kind}Url`}
                      name={`${item.kind}Url`}
                      type="text"
                      inputmode="url"
                      autocomplete="url"
                      value={item.kind === 'spotify' ? profile.spotify_url || '' : profile.youtube_url || ''}
                      placeholder={item.kind === 'spotify' ? 'Enlace de una canción' : 'Enlace de un vídeo o Short'}
                      aria-label={item.kind === 'spotify' ? 'Enlace de la canción de Spotify' : 'Enlace del vídeo de YouTube'}
                      data-media-url={item.kind}
                    />
                  </div>
                </div>
                <label class="switch" title={`Mostrar ${item.kind === 'spotify' ? 'canción' : 'vídeo'}`}>
                  <input
                    name={`${item.kind}Enabled`}
                    type="checkbox"
                    checked={item.kind === 'spotify' ? profile.spotify_enabled : profile.youtube_enabled}
                    data-media-enabled={item.kind}
                  />
                  <span></span>
                </label>
                <div class="order-actions">
                  <button type="button" data-move="up" aria-label={`Subir ${item.kind === 'spotify' ? 'Spotify' : 'YouTube'}`}>↑</button>
                  <button type="button" data-move="down" aria-label={`Bajar ${item.kind === 'spotify' ? 'Spotify' : 'YouTube'}`}>↓</button>
                </div>
              </article>
            ))}
        </div>
      </section>

      <section class="publish-card">
        <div>
          <h2>Página visible</h2>
          <p>{profile.suspended_at
            ? 'La publicación está bloqueada hasta que finalice la revisión.'
            : 'Si la desactivas, nadie podrá verla aunque tenga el enlace.'}</p>
        </div>
        <label class="switch switch--large">
          <input name="published" type="checkbox" checked={profile.published} disabled={Boolean(profile.suspended_at)} />
          <span></span>
        </label>
      </section>

      <div class="save-bar">
        <span>{Astro.url.host}/<b data-current-slug>{profile.slug}</b></span>
        <button class="button button--coral" type="submit">Guardar cambios</button>
      </div>
    </form>

    <aside class="preview-column">
      <div class="preview-heading">
        <span>Vista previa</span>
        <i>En directo</i>
      </div>
      <div class:list={[
        'preview-phone',
        {
          'preview-phone--pulse': profile.template_id === 'pulse',
          'preview-phone--aura': profile.template_id === 'aura',
          'preview-phone--frame': profile.template_id === 'frame',
        },
      ]} style={profileStyle}>
        <div class="preview-phone__screen">
          <div class="preview-profile">
            <div class="preview-avatar">
              {profile.avatar_url ? <img class="avatar-live-image" src={profile.avatar_url} alt="" data-preview-avatar /> : <b data-preview-initials>{profile.display_name[0]}</b>}
            </div>
            <div>
              <small data-preview-slug>@{profile.slug}</small>
              <h2 data-preview-name>{profile.display_name}</h2>
              <p data-preview-tagline>{profile.tagline}</p>
            </div>
          </div>
          <p class="preview-bio" data-preview-bio hidden={!profile.bio}>{profile.bio}</p>
          <nav class="preview-socials" data-preview-socials aria-label="Redes sociales">
            {socialProfiles.map((social) => (
              <a
                href={social.url || '#'}
                aria-label={social.label}
                data-preview-social={social.platform}
                hidden={!social.enabled || !social.url}
              ><SocialIcon platform={social.platform} /></a>
            ))}
          </nav>
          <div class="preview-links" data-preview-content>
            {contentItems.map((item) => item.kind === 'link'
              ? item.link.enabled && item.link.title && item.link.url && (
                  <>
                    {item.link.section_title && <p class="preview-section-title">{item.link.section_title}</p>}
                    <span><small class="preview-link-icon" aria-hidden="true">{getPreviewLinkIcon(item.link.title, item.link.url)}</small><b>{item.link.title}</b><i>↗</i></span>
                  </>
                )
              : (item.kind === 'spotify' ? profile.spotify_enabled : profile.youtube_enabled) && mediaPreviewUrls[item.kind] && (
                  <article class={`preview-player preview-player--${item.kind}`} data-preview-media={item.kind}>
                    <iframe
                      src={mediaPreviewUrls[item.kind]}
                      title={item.kind === 'spotify' ? 'Vista previa de Spotify' : 'Vista previa de YouTube'}
                      tabindex="-1"
                      loading="lazy"
                      {...iframeNoScroll}
                      allow={item.kind === 'spotify' ? 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture' : 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'}
                      allowfullscreen={item.kind === 'youtube'}
                    ></iframe>
                  </article>
                ))}
          </div>
          <p class="preview-brand">T · hecho con Trazli</p>
        </div>
      </div>
      <p class="preview-note">Así se verá principalmente en móvil.</p>
    </aside>
  </main>
  <LegalFooter />
</Layout>

<script>
  import { getSpotifyEmbedUrl, getYouTubeEmbedUrl } from '../../lib/media.js';

  const getPreviewLinkIcon = (title: string, value: string) => {
    const label = title.toLowerCase();
    try {
      const hostname = new URL(value).hostname.replace(/^www\./, '').toLowerCase();
      if (hostname.includes('instagram.com') || label.includes('instagram')) return '◎';
      if (hostname.includes('tiktok.com') || label.includes('tiktok')) return '♪';
      if (hostname.includes('youtube.com') || hostname === 'youtu.be' || label.includes('youtube')) return '▶';
    } catch {
      // Keep showing a neutral web icon while the user finishes the URL.
    }
    return '⊙';
  };

  const previewPhone = document.querySelector<HTMLElement>('.preview-phone');
  const getField = (selector: string) => document.querySelector<HTMLInputElement>(selector);
  const setText = (selector: string, value: string) => {
    const target = document.querySelector(selector);
    if (target) target.textContent = value;
  };

  const updateSocials = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-preview-social]').forEach((link) => {
      const platform = link.dataset.previewSocial;
      const url = getField(`[data-social-url="${platform}"]`)?.value.trim() || '';
      const enabled = getField(`[data-social-enabled="${platform}"]`)?.checked;
      link.href = url || '#';
      link.hidden = !url || !enabled;
    });
  };

  document.querySelectorAll<HTMLInputElement>('[data-social-url], [data-social-enabled]').forEach((input) => {
    input.addEventListener(input.type === 'checkbox' ? 'change' : 'input', updateSocials);
  });

  document.querySelectorAll<HTMLElement>('[data-section-control]').forEach((control) => {
    const toggle = control.querySelector<HTMLButtonElement>('[data-section-toggle]');
    const field = control.querySelector<HTMLElement>('[data-section-field]');
    const input = control.querySelector<HTMLInputElement>('[data-link-section]');
    const action = control.querySelector<HTMLElement>('[data-section-action]');

    toggle?.addEventListener('click', () => {
      if (!field || !input) return;
      const willOpen = field.hidden === true;
      field.hidden = !willOpen;
      control.classList.toggle('link-section-control--open', willOpen);
      toggle.setAttribute('aria-expanded', String(willOpen));
      if (action) action.textContent = willOpen ? 'Quitar' : '+ Empezar aquí';
      if (willOpen) {
        input.focus();
      } else {
        input.value = '';
        updateContent();
      }
    });
  });

  document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-preview]').forEach((input) => {
    input.addEventListener('input', () => {
      const key = input.dataset.preview;
      const value = input.value;
      if (key === 'name') {
        setText('[data-preview-name]', value || 'Tu nombre');
        setText('[data-preview-initials]', value?.[0]?.toUpperCase() || 'T');
      } else if (key === 'slug') {
        setText('[data-preview-slug]', `@${value || 'tuusuario'}`);
        setText('[data-current-slug]', value || 'tuusuario');
      } else if (key === 'tagline') {
        setText('[data-preview-tagline]', value);
      } else if (key === 'bio') {
        setText('[data-preview-bio]', value);
        const bio = document.querySelector<HTMLElement>('[data-preview-bio]');
        if (bio) bio.hidden = !value.trim();
      }
    });
  });

  const slugInput = document.querySelector<HTMLInputElement>('#slug');
  const slugStatus = document.querySelector<HTMLElement>('[data-slug-status]');
  let slugTimer = 0;
  let slugRequest: AbortController | null = null;

  slugInput?.addEventListener('input', () => {
    window.clearTimeout(slugTimer);
    slugRequest?.abort();
    if (slugInput.value.trim().length < 3) {
      if (slugStatus) slugStatus.textContent = 'Usa al menos 3 caracteres.';
      return;
    }

    if (slugStatus) {
      slugStatus.textContent = 'Comprobando...';
      slugStatus.dataset.state = '';
    }
    slugTimer = window.setTimeout(async () => {
      slugRequest = new AbortController();
      try {
        const response = await fetch(`/api/slug/check?slug=${encodeURIComponent(slugInput.value)}`, {
          signal: slugRequest.signal,
        });
        const result = await response.json();
        if (slugStatus) {
          slugStatus.textContent = result.message;
          slugStatus.dataset.state = result.available ? 'available' : 'unavailable';
        }
      } catch (error) {
        if ((error as Error).name !== 'AbortError' && slugStatus) {
          slugStatus.textContent = 'No se puede comprobar ahora mismo.';
        }
      }
    }, 350);
  });

  const avatarInput = document.querySelector<HTMLInputElement>('[data-avatar-input]');
  const removeAvatar = document.querySelector<HTMLInputElement>('[data-remove-avatar]');
  const avatarUploader = document.querySelector<HTMLElement>('.avatar-uploader');
  const uploadPreview = document.querySelector<HTMLElement>('[data-upload-preview]');
  const avatarFileName = document.querySelector<HTMLElement>('[data-avatar-file-name]');
  const avatarPositionControls = document.querySelector<HTMLElement>('[data-avatar-position-controls]');
  const currentAvatar = avatarUploader?.dataset.currentAvatar || '';
  let avatarObjectUrl = '';

  const createAvatarContent = (src = '') => {
    if (src) {
      const image = document.createElement('img');
      image.src = src;
      image.alt = '';
      image.className = 'avatar-live-image';
      return image;
    }
    const fallback = document.createElement('b');
    fallback.dataset.previewInitials = '';
    fallback.textContent = document.querySelector<HTMLElement>('[data-preview-name]')
      ?.textContent?.trim()?.[0]?.toUpperCase() || 'T';
    return fallback;
  };

  const showAvatarPreview = (src = '') => {
    const avatar = document.querySelector<HTMLElement>('.preview-avatar');
    const cropPreviews = document.querySelectorAll<HTMLElement>('[data-avatar-crop-preview]');
    if (!src) {
      avatar?.replaceChildren(createAvatarContent());
      uploadPreview?.replaceChildren(createAvatarContent());
      cropPreviews.forEach((preview) => preview.replaceChildren(createAvatarContent()));
    } else {
      avatar?.replaceChildren(createAvatarContent(src));
      uploadPreview?.replaceChildren(createAvatarContent(src));
      cropPreviews.forEach((preview) => preview.replaceChildren(createAvatarContent(src)));
    }
  };

  avatarInput?.addEventListener('change', () => {
    if (avatarObjectUrl) URL.revokeObjectURL(avatarObjectUrl);
    const file = avatarInput.files?.[0];
    if (!file) return;
    if (file.size > 12 * 1024 * 1024) {
      avatarInput.setCustomValidity('La foto no puede superar los 12 MB.');
      avatarFileName && (avatarFileName.textContent = 'El archivo supera los 12 MB');
      return;
    }
    avatarInput.setCustomValidity('');
    avatarObjectUrl = URL.createObjectURL(file);
    if (removeAvatar) removeAvatar.checked = false;
    if (avatarFileName) avatarFileName.textContent = file.name;
    if (avatarPositionControls) avatarPositionControls.hidden = false;
    showAvatarPreview(avatarObjectUrl);
  });

  removeAvatar?.addEventListener('change', () => {
    if (removeAvatar.checked) {
      if (avatarInput) avatarInput.value = '';
      if (avatarFileName) avatarFileName.textContent = 'La foto se quitará al guardar';
      if (avatarPositionControls) avatarPositionControls.hidden = true;
      showAvatarPreview();
    } else {
      if (avatarFileName) avatarFileName.textContent = 'Ningún archivo seleccionado';
      if (avatarPositionControls) avatarPositionControls.hidden = !currentAvatar;
      showAvatarPreview(currentAvatar);
    }
  });

  document.querySelectorAll<HTMLInputElement>('[data-color]').forEach((input) => {
    input.addEventListener('input', () => {
      const variables: Record<string, string> = {
        bg: '--preview-bg',
        accent: '--preview-accent',
        text: '--preview-text',
      };
      const variable = variables[input.dataset.color || ''];
      if (variable) previewPhone?.style.setProperty(variable, input.value);
    });
  });

  document.querySelectorAll<HTMLInputElement>('input[name="templateId"]').forEach((input) => {
    input.addEventListener('change', () => {
      previewPhone?.classList.remove(
        'preview-phone--pulse',
        'preview-phone--aura',
        'preview-phone--frame',
      );
      if (input.value !== 'studio') {
        previewPhone?.classList.add(`preview-phone--${input.value}`);
      }
    });
  });

  const updateContent = () => {
    const target = document.querySelector('[data-preview-content]');
    if (!target) return;
    target.innerHTML = '';
    const rows = document.querySelectorAll<HTMLElement>('[data-content-row]');
    for (const row of rows) {
      const platform = row.dataset.mediaRow as 'spotify' | 'youtube' | undefined;
      if (platform) {
        const url = getField(`[data-media-url="${platform}"]`)?.value.trim();
        const enabled = getField(`[data-media-enabled="${platform}"]`)?.checked;
        const embedUrl = platform === 'spotify' ? getSpotifyEmbedUrl(url) : getYouTubeEmbedUrl(url);
        if (!embedUrl || !enabled) continue;

        const item = document.createElement('article');
        item.className = `preview-player preview-player--${platform}`;
        item.dataset.previewMedia = platform;
        const iframe = document.createElement('iframe');
        iframe.src = embedUrl;
        iframe.title = platform === 'spotify' ? 'Vista previa de Spotify' : 'Vista previa de YouTube';
        iframe.tabIndex = -1;
        iframe.loading = 'lazy';
        iframe.setAttribute('scrolling', 'no');
        iframe.allow = platform === 'spotify'
          ? 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'
          : 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = platform === 'youtube';
        item.appendChild(iframe);
        target.appendChild(item);
        continue;
      }

      const index = row.dataset.linkRow;
      const title = getField(`[data-link-title="${index}"]`)?.value.trim();
      const url = getField(`[data-link-url="${index}"]`)?.value.trim();
      const sectionTitle = getField(`[data-link-section="${index}"]`)?.value.trim();
      const enabled = getField(`[data-link-enabled="${index}"]`)?.checked;
      if (!title || !url || !enabled) continue;
      if (sectionTitle) {
        const heading = document.createElement('p');
        heading.className = 'preview-section-title';
        heading.textContent = sectionTitle;
        target.appendChild(heading);
      }
      const item = document.createElement('span');
      item.innerHTML = `<small class="preview-link-icon" aria-hidden="true">${getPreviewLinkIcon(title, url)}</small><b></b><i>↗</i>`;
      const titleNode = item.querySelector('b');
      if (titleNode) titleNode.textContent = title;
      target.appendChild(item);
    }
  };

  document.querySelectorAll<HTMLInputElement>('[data-link-title], [data-link-url], [data-link-section], [data-link-enabled], [data-media-url], [data-media-enabled]')
    .forEach((input) => input.addEventListener('input', updateContent));

  const linksEditor = document.querySelector<HTMLElement>('.links-editor');
  let draggedRow: HTMLElement | null = null;

  const syncLinkOrder = () => {
    linksEditor?.querySelectorAll<HTMLElement>('[data-content-row]').forEach((row, position) => {
      const field = row.querySelector<HTMLInputElement>('[data-content-position]');
      if (field) field.value = String(position);
    });
    updateContent();
  };

  linksEditor?.querySelectorAll<HTMLElement>('[data-content-row]').forEach((row) => {
    row.addEventListener('dragstart', (event) => {
      draggedRow = row;
      event.dataTransfer?.setData('text/plain', row.dataset.contentRow || '');
      if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
      row.classList.add('link-row--dragging');
    });
    row.addEventListener('dragend', () => {
      row.classList.remove('link-row--dragging');
      draggedRow = null;
      syncLinkOrder();
    });
    row.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (!draggedRow || draggedRow === row || !linksEditor) return;
      const bounds = row.getBoundingClientRect();
      const insertAfter = event.clientY > bounds.top + bounds.height / 2;
      linksEditor.insertBefore(draggedRow, insertAfter ? row.nextSibling : row);
    });
  });

  linksEditor?.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((button) => {
    button.addEventListener('click', () => {
      const row = button.closest<HTMLElement>('[data-content-row]');
      if (!row || !linksEditor) return;
      if (button.dataset.move === 'up' && row.previousElementSibling) {
        linksEditor.insertBefore(row, row.previousElementSibling);
      } else if (button.dataset.move === 'down' && row.nextElementSibling) {
        linksEditor.insertBefore(row.nextElementSibling, row);
      }
      syncLinkOrder();
    });
  });
</script>

