---
import Layout from '../../layouts/Layout.astro';
import { getEditableProfile } from '../../lib/profiles.js';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const profile = await getEditableProfile(user.id);
if (!profile) return Astro.redirect('/login');

const links = Array.from({ length: 6 }, (_, index) => (
  profile.links[index] || { title: '', url: '', enabled: true }
));
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved');
const welcome = Astro.url.searchParams.get('welcome');
const profileStyle = `--preview-bg:${profile.background_color};--preview-accent:${profile.accent_color};--preview-text:${profile.text_color}`;
---

<Layout title="Mi panel | Nexo" description="Configura y publica tu página de Nexo." bodyClass="dashboard-body">
  <header class="app-header">
    <a class="brand" href="/"><span>N</span>Nexo</a>
    <div class="app-header__actions">
      <a href={`/${profile.slug}`} target="_blank">Ver mi página ↗</a>
      <form action="/api/auth/logout" method="post">
        <button type="submit">Salir</button>
      </form>
    </div>
  </header>

  <main class="dashboard">
    <form class="editor" action="/api/profile/save" method="post">
      <div class="editor__heading">
        <p class="eyebrow">Tu página</p>
        <h1>Hazla tuya.</h1>
        <p>Cambia lo que necesites. Verás el resultado al momento.</p>
      </div>

      {error && <p class="notice" role="alert">{error}</p>}
      {saved && <p class="notice notice--success">Cambios guardados y publicados.</p>}
      {welcome && <p class="notice notice--success">Tu página ya existe. Ahora dale tu estilo.</p>}

      <section class="editor-card">
        <div class="section-title">
          <span>01</span>
          <div><h2>Lo esencial</h2><p>Cómo te presentas al mundo.</p></div>
        </div>
        <div class="fields-grid">
          <div class="field">
            <label for="displayName">Nombre</label>
            <input id="displayName" name="displayName" maxlength="60" value={profile.display_name} data-preview="name" required />
          </div>
          <div class="field">
            <label for="slug">Dirección</label>
            <div class="slug-input">
              <span>/</span>
              <input id="slug" name="slug" maxlength="30" value={profile.slug} data-preview="slug" required />
            </div>
          </div>
        </div>
        <div class="field">
          <label for="tagline">Frase corta</label>
          <input id="tagline" name="tagline" maxlength="100" value={profile.tagline} data-preview="tagline" />
        </div>
        <div class="field">
          <label for="bio">Sobre ti</label>
          <textarea id="bio" name="bio" maxlength="280" data-preview="bio">{profile.bio}</textarea>
          <small class="field__hint">Máximo 280 caracteres.</small>
        </div>
        <div class="field">
          <label for="avatarUrl">Foto</label>
          <input
            id="avatarUrl"
            name="avatarUrl"
            type="url"
            value={profile.avatar_url}
            data-preview="avatar"
            placeholder="https://..."
          />
          <small class="field__hint">Pega la URL pública de tu foto. La subida directa llegará en la siguiente fase.</small>
        </div>
      </section>

      <section class="editor-card">
        <div class="section-title">
          <span>02</span>
          <div><h2>Diseño</h2><p>Dos personalidades, los colores que quieras.</p></div>
        </div>
        <div class="template-options">
          <label class="template-option">
            <input type="radio" name="templateId" value="studio" checked={profile.template_id === 'studio'} />
            <span class="template-preview template-preview--studio"><i></i><b>Studio</b></span>
            <small>Editorial y serena</small>
          </label>
          <label class="template-option">
            <input type="radio" name="templateId" value="pulse" checked={profile.template_id === 'pulse'} />
            <span class="template-preview template-preview--pulse"><i></i><b>Pulse</b></span>
            <small>Gráfica y directa</small>
          </label>
        </div>
        <div class="color-options">
          <label>
            <span>Fondo</span>
            <input type="color" name="backgroundColor" value={profile.background_color} data-color="bg" />
          </label>
          <label>
            <span>Acento</span>
            <input type="color" name="accentColor" value={profile.accent_color} data-color="accent" />
          </label>
          <label>
            <span>Texto</span>
            <input type="color" name="textColor" value={profile.text_color} data-color="text" />
          </label>
        </div>
      </section>

      <section class="editor-card">
        <div class="section-title">
          <span>03</span>
          <div><h2>Tus enlaces</h2><p>Activa solo lo que quieras enseñar.</p></div>
        </div>
        <div class="links-editor">
          {links.map((link, index) => (
            <article class="link-row">
              <span class="drag" aria-hidden="true">··</span>
              <div class="link-fields">
                <input
                  name={`linkTitle${index}`}
                  value={link.title}
                  maxlength="60"
                  placeholder={index === 0 ? 'Instagram' : 'Título del enlace'}
                  aria-label={`Título del enlace ${index + 1}`}
                  data-link-title={index}
                />
                <input
                  name={`linkUrl${index}`}
                  value={link.url}
                  type="text"
                  inputmode="url"
                  autocomplete="url"
                  placeholder="instagram.com/tuusuario"
                  aria-label={`URL del enlace ${index + 1}`}
                  data-link-url={index}
                />
              </div>
              <label class="switch" title="Mostrar enlace">
                <input name={`linkEnabled${index}`} type="checkbox" checked={link.enabled} data-link-enabled={index} />
                <span></span>
              </label>
            </article>
          ))}
        </div>
      </section>

      <section class="publish-card">
        <div>
          <h2>Página visible</h2>
          <p>Si la desactivas, nadie podrá verla aunque tenga el enlace.</p>
        </div>
        <label class="switch switch--large">
          <input name="published" type="checkbox" checked={profile.published} />
          <span></span>
        </label>
      </section>

      <div class="save-bar">
        <span>nexo.app/<b data-current-slug>{profile.slug}</b></span>
        <button class="button button--coral" type="submit">Guardar cambios</button>
      </div>
    </form>

    <aside class="preview-column">
      <div class="preview-heading">
        <span>Vista previa</span>
        <i>En directo</i>
      </div>
      <div class:list={['preview-phone', { 'preview-phone--pulse': profile.template_id === 'pulse' }]} style={profileStyle}>
        <div class="preview-phone__screen">
          <div class="preview-profile">
            <div class="preview-avatar">
              {profile.avatar_url ? <img src={profile.avatar_url} alt="" data-preview-avatar /> : <b data-preview-initials>{profile.display_name[0]}</b>}
            </div>
            <div>
              <small data-preview-slug>@{profile.slug}</small>
              <h2 data-preview-name>{profile.display_name}</h2>
              <p data-preview-tagline>{profile.tagline}</p>
            </div>
          </div>
          <p class="preview-bio" data-preview-bio>{profile.bio}</p>
          <div class="preview-links" data-preview-links>
            {links.filter((link) => link.enabled && link.title && link.url).map((link, index) => (
              <span><small>{String(index + 1).padStart(2, '0')}</small><b>{link.title}</b><i>↗</i></span>
            ))}
          </div>
          <p class="preview-brand">N · hecho con Nexo</p>
        </div>
      </div>
      <p class="preview-note">Así se verá principalmente en móvil.</p>
    </aside>
  </main>
</Layout>

<script>
  const previewPhone = document.querySelector<HTMLElement>('.preview-phone');
  const getField = (selector: string) => document.querySelector<HTMLInputElement>(selector);
  const setText = (selector: string, value: string) => {
    const target = document.querySelector(selector);
    if (target) target.textContent = value;
  };

  document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-preview]').forEach((input) => {
    input.addEventListener('input', () => {
      const key = input.dataset.preview;
      const value = input.value;
      if (key === 'name') {
        setText('[data-preview-name]', value || 'Tu nombre');
        setText('[data-preview-initials]', value?.[0]?.toUpperCase() || 'N');
      } else if (key === 'slug') {
        setText('[data-preview-slug]', `@${value || 'tuusuario'}`);
        setText('[data-current-slug]', value || 'tuusuario');
      } else if (key === 'tagline') {
        setText('[data-preview-tagline]', value);
      } else if (key === 'bio') {
        setText('[data-preview-bio]', value);
      } else if (key === 'avatar') {
        const avatar = document.querySelector('.preview-avatar');
        if (!avatar) return;
        const image = avatar.querySelector<HTMLImageElement>('img');
        if (value) {
          if (image) image.src = value;
          else {
            const newImage = document.createElement('img');
            newImage.src = value;
            newImage.alt = '';
            newImage.dataset.previewAvatar = '';
            avatar.replaceChildren(newImage);
          }
        }
      }
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-color]').forEach((input) => {
    input.addEventListener('input', () => {
      const variables: Record<string, string> = {
        bg: '--preview-bg',
        accent: '--preview-accent',
        text: '--preview-text',
      };
      const variable = variables[input.dataset.color || ''];
      if (variable) previewPhone?.style.setProperty(variable, input.value);
    });
  });

  document.querySelectorAll<HTMLInputElement>('input[name="templateId"]').forEach((input) => {
    input.addEventListener('change', () => {
      previewPhone?.classList.toggle('preview-phone--pulse', input.value === 'pulse');
    });
  });

  const updateLinks = () => {
    const target = document.querySelector('[data-preview-links]');
    if (!target) return;
    target.innerHTML = '';
    for (let index = 0; index < 6; index += 1) {
      const title = getField(`[data-link-title="${index}"]`)?.value.trim();
      const url = getField(`[data-link-url="${index}"]`)?.value.trim();
      const enabled = getField(`[data-link-enabled="${index}"]`)?.checked;
      if (!title || !url || !enabled) continue;
      const item = document.createElement('span');
      const count = target.children.length + 1;
      item.innerHTML = `<small>${String(count).padStart(2, '0')}</small><b></b><i>↗</i>`;
      const titleNode = item.querySelector('b');
      if (titleNode) titleNode.textContent = title;
      target.appendChild(item);
    }
  };

  document.querySelectorAll<HTMLInputElement>('[data-link-title], [data-link-url], [data-link-enabled]')
    .forEach((input) => input.addEventListener('input', updateLinks));
</script>

<style>
  :global(.dashboard-body) { background: #ebe9e2; }
  .app-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    min-height: 4.5rem;
    padding: 0.75rem clamp(1rem, 4vw, 3rem);
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    background: rgba(247, 244, 237, 0.92);
    backdrop-filter: blur(14px);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; font-weight: 850; }
  .brand span {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border-radius: 0.65rem 0.65rem 0.65rem 0.2rem;
    background: var(--ink);
    color: white;
    font-family: var(--font-display);
  }
  .app-header__actions { display: flex; align-items: center; gap: 1rem; }
  .app-header__actions a, .app-header__actions button {
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 750;
    text-underline-offset: 0.2rem;
    cursor: pointer;
  }
  .dashboard {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(360px, 1fr);
    width: min(1380px, 100% - 2rem);
    margin: 0 auto;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .editor { display: grid; gap: 1.15rem; padding-block: 3rem 8rem; }
  .editor__heading h1 {
    margin: 0.8rem 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }
  .editor__heading > p:last-child { color: var(--muted); line-height: 1.5; }
  .editor-card, .publish-card {
    padding: clamp(1.1rem, 3vw, 1.7rem);
    border: 1px solid var(--line);
    border-radius: 1.2rem;
    background: var(--surface);
    box-shadow: 0 10px 35px rgba(36, 43, 40, 0.035);
  }
  .editor-card { display: grid; gap: 1.25rem; }
  .section-title { display: flex; align-items: flex-start; gap: 0.9rem; }
  .section-title > span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: white;
    font-size: 0.65rem;
    font-weight: 800;
  }
  .section-title h2, .publish-card h2 { margin: 0; font-family: var(--font-display); font-size: 1.55rem; font-weight: 650; }
  .section-title p, .publish-card p { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.78rem; }
  .fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .slug-input { display: flex; align-items: center; overflow: hidden; border: 1px solid var(--line); border-radius: 0.85rem; background: white; }
  .slug-input span { padding-left: 0.8rem; color: var(--muted); }
  .slug-input input { border: 0; padding-left: 0.1rem; box-shadow: none; }
  .template-options { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .template-option { cursor: pointer; }
  .template-option input { position: absolute; opacity: 0; pointer-events: none; }
  .template-preview {
    display: flex;
    height: 145px;
    padding: 1rem;
    flex-direction: column;
    border: 2px solid transparent;
    border-radius: 1rem;
    background: #eef3f1;
    transition: border 160ms ease, transform 160ms ease;
  }
  .template-preview i { width: 2.8rem; height: 2.8rem; margin: auto; border-radius: 0.7rem; background: var(--mint); }
  .template-preview b { font-family: var(--font-display); font-size: 1.35rem; }
  .template-preview--pulse { border-radius: 0; background: var(--yellow); }
  .template-preview--pulse i { border-radius: 50%; background: var(--coral); }
  .template-preview--pulse b { font-family: var(--font-body); font-weight: 900; text-transform: uppercase; }
  .template-option input:checked + .template-preview { border-color: var(--coral); transform: translateY(-2px); }
  .template-option > small { display: block; margin-top: 0.45rem; color: var(--muted); text-align: center; font-size: 0.72rem; }
  .color-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  .color-options label { display: flex; min-height: 3.6rem; padding: 0.6rem; align-items: center; gap: 0.65rem; border: 1px solid var(--line); border-radius: 0.85rem; }
  .color-options span { font-size: 0.74rem; font-weight: 750; }
  .color-options input { width: 2.3rem; height: 2.3rem; padding: 0; border: 0; background: none; cursor: pointer; }
  .links-editor { display: grid; gap: 0.7rem; }
  .link-row { display: grid; grid-template-columns: 1rem 1fr auto; align-items: center; gap: 0.65rem; }
  .drag { color: #a4aaa7; font-weight: 900; letter-spacing: -0.15em; writing-mode: vertical-rl; }
  .link-fields { display: grid; grid-template-columns: 0.75fr 1.25fr; overflow: hidden; border: 1px solid var(--line); border-radius: 0.8rem; background: white; }
  .link-fields input { min-width: 0; height: 2.8rem; padding: 0 0.75rem; border: 0; outline: 0; color: var(--ink); }
  .link-fields input + input { border-left: 1px solid var(--line); }
  .switch { position: relative; display: inline-flex; cursor: pointer; }
  .switch input { position: absolute; opacity: 0; }
  .switch span { position: relative; width: 2.5rem; height: 1.45rem; border-radius: 999px; background: #cdd1cf; transition: background 160ms ease; }
  .switch span::after {
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    background: white;
    content: '';
    transition: transform 160ms ease;
  }
  .switch input:checked + span { background: var(--coral); }
  .switch input:checked + span::after { transform: translateX(1.05rem); }
  .switch--large span { width: 3rem; height: 1.7rem; }
  .switch--large span::after { width: 1.3rem; height: 1.3rem; }
  .switch--large input:checked + span::after { transform: translateX(1.3rem); }
  .publish-card { display: flex; align-items: center; justify-content: space-between; }
  .save-bar {
    position: sticky;
    z-index: 10;
    bottom: 1rem;
    display: flex;
    padding: 0.75rem 0.8rem 0.75rem 1rem;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 1rem;
    background: var(--ink);
    color: white;
    box-shadow: 0 16px 40px rgba(23, 32, 29, 0.25);
  }
  .save-bar > span { overflow: hidden; text-overflow: ellipsis; font-size: 0.76rem; white-space: nowrap; }
  .save-bar .button { min-height: 2.6rem; }
  .preview-column { position: sticky; top: 6.5rem; padding-top: 3rem; }
  .preview-heading { display: flex; width: min(100%, 360px); margin: 0 auto 0.7rem; justify-content: space-between; color: var(--muted); font-size: 0.72rem; font-weight: 750; }
  .preview-heading i { color: #24805e; font-style: normal; }
  .preview-heading i::before { content: '● '; }
  .preview-phone {
    --soft: color-mix(in srgb, var(--preview-text) 12%, transparent);
    width: min(100%, 360px);
    height: min(690px, calc(100dvh - 11rem));
    min-height: 570px;
    margin: 0 auto;
    padding: 0.65rem;
    overflow: hidden;
    border: 7px solid var(--ink);
    border-radius: 2.6rem;
    background: var(--ink);
    box-shadow: 0 30px 65px rgba(23, 32, 29, 0.22);
  }
  .preview-phone__screen {
    display: flex;
    height: 100%;
    padding: 3rem 1rem 1rem;
    overflow-y: auto;
    flex-direction: column;
    border-radius: 2rem;
    background:
      linear-gradient(var(--soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--soft) 1px, transparent 1px),
      var(--preview-bg);
    background-size: 30px 30px;
    color: var(--preview-text);
  }
  .preview-profile { display: flex; align-items: flex-end; gap: 0.8rem; }
  .preview-avatar { display: grid; width: 5rem; height: 6rem; flex: 0 0 auto; place-items: center; overflow: hidden; border-radius: 1rem 1rem 1rem 0.25rem; background: var(--preview-accent); }
  .preview-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .preview-avatar b { font-family: var(--font-display); font-size: 1.8rem; }
  .preview-profile small { color: var(--preview-accent); font-size: 0.55rem; font-weight: 850; text-transform: uppercase; }
  .preview-profile h2 { margin: 0.15rem 0; font-family: var(--font-display); font-size: 2rem; letter-spacing: -0.06em; line-height: 0.85; }
  .preview-profile p { margin: 0.3rem 0 0; font-size: 0.55rem; font-weight: 700; }
  .preview-bio { margin: 1.2rem 0; opacity: 0.75; font-size: 0.66rem; line-height: 1.5; }
  .preview-links { display: grid; gap: 0.5rem; }
  .preview-links :global(span) {
    display: grid;
    grid-template-columns: 1.6rem 1fr auto;
    min-height: 3.1rem;
    padding: 0.6rem;
    align-items: center;
    border: 1px solid var(--soft);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--preview-bg) 82%, white);
  }
  .preview-links :global(small) { opacity: 0.45; font-size: 0.48rem; }
  .preview-links :global(b) { font-size: 0.62rem; }
  .preview-links :global(i) { display: grid; width: 1.5rem; height: 1.5rem; place-items: center; border-radius: 50%; background: var(--preview-accent); font-size: 0.65rem; font-style: normal; }
  .preview-brand { margin: auto 0 0; text-align: center; opacity: 0.5; font-size: 0.5rem; }
  .preview-phone--pulse .preview-phone__screen {
    background:
      radial-gradient(circle at 0 0, var(--preview-accent) 0 18%, transparent 18.3%),
      var(--preview-bg);
  }
  .preview-phone--pulse .preview-profile { align-items: center; flex-direction: column; text-align: center; }
  .preview-phone--pulse .preview-avatar { width: 6rem; height: 6rem; border: 4px solid var(--preview-text); border-radius: 50%; box-shadow: 6px 6px 0 var(--preview-accent); }
  .preview-phone--pulse .preview-profile h2 { font-family: var(--font-body); font-weight: 900; text-transform: uppercase; }
  .preview-phone--pulse .preview-bio { text-align: center; }
  .preview-phone--pulse .preview-links :global(span) { border: 2px solid var(--preview-text); border-radius: 0; background: var(--preview-accent); box-shadow: 4px 4px 0 var(--preview-text); }
  .preview-note { color: var(--muted); text-align: center; font-size: 0.68rem; }
  @media (max-width: 980px) {
    .dashboard { grid-template-columns: minmax(0, 1fr) 330px; gap: 1.5rem; }
    .preview-phone { height: 620px; }
  }
  @media (max-width: 760px) {
    .dashboard { display: flex; width: min(100% - 1rem, 760px); flex-direction: column-reverse; }
    .preview-column { position: relative; top: 0; width: 100%; padding-top: 1.5rem; }
    .preview-phone { height: 560px; }
    .editor { width: 100%; padding-top: 1rem; }
  }
  @media (max-width: 520px) {
    .app-header__actions a { display: none; }
    .fields-grid, .template-options { grid-template-columns: 1fr; }
    .link-row { grid-template-columns: 0.7rem 1fr auto; }
    .link-fields { grid-template-columns: 1fr; }
    .link-fields input + input { border-top: 1px solid var(--line); border-left: 0; }
    .save-bar > span { max-width: 42%; }
  }
</style>
