---
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/AuthShell.astro';
import { isEmailDeliveryConfigured } from '../lib/email.js';

if (Astro.locals.user) return Astro.redirect('/app');
const error = Astro.url.searchParams.get('error');
const verified = Astro.url.searchParams.get('verified');
const emailEnabled = isEmailDeliveryConfigured();
const requestedNext = Astro.url.searchParams.get('next') || '';
const next = requestedNext === '/app' || requestedNext.startsWith('/app/')
  ? requestedNext
  : '/app';
---

<Layout title="Entrar | Trazli" description="Accede a tu cuenta de Trazli.">
  <AuthShell
    title="Vuelve a tu espacio."
    intro="Entra para actualizar tus enlaces, tu diseño o lo que quieras contar hoy."
    alternateText="¿Todavía no tienes una página?"
    alternateHref="/registro"
    alternateLabel="Créala gratis"
  >
    <form class="auth-form" action="/api/auth/login" method="post">
      {error && <p class="notice" role="alert">{error}</p>}
      {verified && <p class="notice notice--success" role="status">Correo verificado. Ya puedes entrar.</p>}
      <input type="hidden" name="next" value={next} />
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        {emailEnabled && (
          <a class="forgot-link" href="/recuperar-contrasena">¿Has olvidado tu contraseña?</a>
        )}
      </div>
      <button class="button button--coral" type="submit">Entrar en mi panel ↗</button>
    </form>
  </AuthShell>
</Layout>

<style>
  .forgot-link {
    justify-self: end;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    text-underline-offset: 0.18rem;
  }
</style>
