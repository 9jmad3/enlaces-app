---
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/AuthShell.astro';

if (Astro.locals.user) return Astro.redirect('/app');
const error = Astro.url.searchParams.get('error');
---

<Layout title="Entrar | Nexo" description="Accede a tu cuenta de Nexo.">
  <AuthShell
    title="Vuelve a tu espacio."
    intro="Entra para actualizar tus enlaces, tu diseño o lo que quieras contar hoy."
    alternateText="¿Todavía no tienes una página?"
    alternateHref="/registro"
    alternateLabel="Créala gratis"
  >
    <form class="auth-form" action="/api/auth/login" method="post">
      {error && <p class="notice" role="alert">{error}</p>}
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="button button--coral" type="submit">Entrar en mi panel ↗</button>
    </form>
  </AuthShell>
</Layout>
