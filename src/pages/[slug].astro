---
import Layout from '../layouts/Layout.astro';
import PublicProfile from '../components/PublicProfile.astro';
import { SOCIAL_IMAGE_VERSION } from '../const';
import { getPublicProfile } from '../lib/profiles.js';

export const prerender = false;

const slug = Astro.params.slug?.toLowerCase() || '';
const profile = await getPublicProfile(slug);

if (!profile) Astro.response.status = 404;

const imageVersion = new URLSearchParams({
  card: SOCIAL_IMAGE_VERSION,
  ...(profile?.updated_at ? { v: String(new Date(profile.updated_at).getTime()) } : {}),
});
const socialImage = profile
  ? `/api/og/${encodeURIComponent(profile.slug)}.png?${imageVersion}`
  : `/api/og/site.png?v=${SOCIAL_IMAGE_VERSION}`;
---

{profile ? (
  <Layout
    title={`${profile.display_name} | Trazli`}
    description={profile.tagline || profile.bio || `Enlaces de ${profile.display_name}`}
    image={socialImage}
    imageAlt={`Tarjeta de ${profile.display_name} en Trazli`}
  >
    <PublicProfile profile={profile} />
  </Layout>
) : (
  <Layout
    title="Página no encontrada | Trazli"
    description="Este perfil no existe o todavía no está publicado."
    noindex
  >
    <main class="not-found">
      <span>404</span>
      <h1>Este espacio está libre.</h1>
      <p>El perfil que buscas no existe o todavía no está publicado.</p>
      <a class="button button--coral" href="/registro">Crear mi página</a>
      <a href="/">Volver al inicio</a>
    </main>
  </Layout>
)}

<style>
  .not-found {
    display: flex;
    min-height: 100dvh;
    padding: 2rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
  }
  .not-found > span {
    color: var(--coral);
    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.15em;
  }
  .not-found h1 {
    max-width: 700px;
    margin: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 620;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }
  .not-found p { margin: 0 0 2rem; color: var(--muted); }
  .not-found > a:last-child { margin-top: 1rem; font-size: 0.82rem; text-underline-offset: 0.2rem; }
</style>
