---
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/AuthShell.astro';

if (Astro.locals.user) return Astro.redirect('/app');
const error = Astro.url.searchParams.get('error');
---

<Layout title="Crear mi página | Nexo" description="Crea gratis tu página personal de enlaces.">
  <AuthShell
    title="Hazte un sitio."
    intro="Tu nombre, tus enlaces y tu estilo. Tardarás menos de lo que imaginas."
    alternateText="¿Ya tienes una cuenta?"
    alternateHref="/login"
    alternateLabel="Entrar"
  >
    <form class="auth-form" action="/api/auth/register" method="post">
      {error && <p class="notice" role="alert">{error}</p>}
      <div class="field">
        <label for="displayName">Tu nombre</label>
        <input id="displayName" name="displayName" maxlength="60" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="slug">Elige tu dirección</label>
        <div class="slug-field">
          <span>/</span>
          <input
            id="slug"
            name="slug"
            minlength="3"
            maxlength="30"
            pattern="[a-zA-Z0-9_-]+"
            autocomplete="username"
            placeholder="tuusuario"
            required
          />
        </div>
        <small class="field__hint" data-slug-status>Será el enlace que compartirás.</small>
      </div>
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          minlength="8"
          maxlength="72"
          autocomplete="new-password"
          required
        />
        <small class="field__hint">Mínimo 8 caracteres.</small>
      </div>
      <button class="button button--coral" type="submit">Crear mi página gratis ↗</button>
    </form>
  </AuthShell>
</Layout>

<script>
  const slugInput = document.querySelector<HTMLInputElement>('#slug');
  const slugStatus = document.querySelector<HTMLElement>('[data-slug-status]');
  let slugTimer = 0;
  let slugRequest: AbortController | null = null;

  const setSlugStatus = (message: string, state = '') => {
    if (!slugStatus) return;
    slugStatus.textContent = message;
    slugStatus.dataset.state = state;
  };

  slugInput?.addEventListener('input', () => {
    window.clearTimeout(slugTimer);
    slugRequest?.abort();
    const slug = slugInput.value.trim();
    if (slug.length < 3) {
      setSlugStatus('Usa al menos 3 caracteres.');
      return;
    }

    setSlugStatus('Comprobando...');
    slugTimer = window.setTimeout(async () => {
      slugRequest = new AbortController();
      try {
        const response = await fetch(`/api/slug/check?slug=${encodeURIComponent(slug)}`, {
          signal: slugRequest.signal,
        });
        const result = await response.json();
        setSlugStatus(result.message, result.available ? 'available' : 'unavailable');
      } catch (error) {
        if ((error as Error).name !== 'AbortError') {
          setSlugStatus('No se puede comprobar ahora mismo.');
        }
      }
    }, 350);
  });
</script>

<style>
  [data-slug-status][data-state='available'] { color: #17704a; }
  [data-slug-status][data-state='unavailable'] { color: #b43824; }
</style>
