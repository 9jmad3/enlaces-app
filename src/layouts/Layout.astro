---
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_IMAGE_VERSION } from '../const';
import BaseHead from '../components/BaseHead.astro';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = `/api/og/site.png?v=${SOCIAL_IMAGE_VERSION}`,
  imageAlt = `${title} en Trazli`,
  noindex = false,
  bodyClass = "",
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
    />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
