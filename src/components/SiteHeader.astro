---
const { user = null } = Astro.props;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="Nexo, pagina principal">
      <span class="brand__mark">N</span>
      <span>Nexo</span>
    </a>
    <nav aria-label="Navegacion principal">
      {user ? (
        <>
          <a class="nav-link" href={`/${user.slug}`}>Ver perfil</a>
          <a class="button" href="/app">Mi panel</a>
        </>
      ) : (
        <>
          <a class="nav-link" href="/login">Entrar</a>
          <a class="button button--coral" href="/registro">Crear mi pagina</a>
        </>
      )}
    </nav>
  </div>
</header>

<style>
  .site-header { position: relative; z-index: 20; padding: 1rem 0; }
  .site-header__inner, nav, .brand { display: flex; align-items: center; }
  .site-header__inner { justify-content: space-between; }
  .brand {
    gap: 0.65rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 850;
    letter-spacing: -0.04em;
  }
  .brand__mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.7rem 0.7rem 0.7rem 0.2rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
  }
  nav { gap: 0.8rem; }
  .nav-link {
    padding: 0.7rem 0.4rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }
  @media (max-width: 520px) {
    .site-header .button { padding-inline: 0.85rem; font-size: 0.82rem; }
    .nav-link { font-size: 0.82rem; }
    .brand > span:last-child { display: none; }
  }
</style>
