---
const { links } = Astro.props;
---
<section class="botones">
  {
    links.map((data) => (
      <a href={data.link} class="boton" data-astro-prefetch target="_blank" rel="nofollow noreferrer noopener">
        <iconify-icon icon={data.icon} width="25" height="25" class="iconify" />
        <span>{data.title}</span>
      </a>
    ))
  }
</section>

<style>
  .botones {
    margin-top: 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0 1rem;
  }

  .boton {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: flex-start;
    min-height: 5.4rem;
    padding: 1.1rem 1.25rem;
    color: var(--button-text);
    font-size: 1.38rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 16px;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
    transition: transform 180ms ease, filter 180ms ease;
  }

  .boton:nth-child(1) { background: linear-gradient(135deg, #e11d48, #fb7185); }
  .boton:nth-child(2) { background: linear-gradient(135deg, #111827, #374151); }
  .boton:nth-child(3) { background: linear-gradient(135deg, #0f172a, #2563eb); }
  .boton:nth-child(4) { background: linear-gradient(135deg, #7c3aed, #06b6d4); }

  .boton:hover {
    transform: translateY(-1px);
    filter: brightness(1.03);
  }

  @media (max-width: 768px) {
    .botones {
      margin-top: 1.3rem;
      padding: 0 0.85rem;
    }

    .boton {
      min-height: 5.1rem;
      font-size: 1.32rem;
    }
  }
</style>
