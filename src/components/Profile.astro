---
const { name, description, bio, image } = Astro.props;
---
<div id="img__container" class="img__container photo">
  <img src={image} alt={name} />
</div>
<h1>{name}</h1>
<p class="bio">
  {description}
  <span>{bio}</span>
</p>

<style>
  .img__container {
    z-index: 50;
    margin-top: 1.5rem;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.86);
    width: 12.2rem;
    height: 12.2rem;
    overflow: hidden;
    margin-bottom: 0.9rem;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.16);
    background: #0f172a;
  }

  .img__container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  h1 {
    margin: 0.9rem 1.2rem 0;
    font-size: clamp(2.6rem, 6.5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-align: center;
    line-height: 0.98;
    color: var(--text-highligth);
  }

  .bio {
    font-size: 1.45rem;
    color: var(--text-highligth);
    text-align: center;
    max-width: 34rem;
    line-height: 1.6;
    margin: 1rem 1.2rem 0;
  }

  .bio span {
    display: block;
    margin-top: 0.8rem;
    color: var(--muted-text);
  }

  :global(.dark) .photo {
    border: 4px solid rgba(103, 232, 249, 0.9);
  }

  @media (max-width: 768px) {
    .img__container {
      width: 10.6rem;
      height: 10.6rem;
      margin-top: 1.2rem;
    }
  }
</style>
