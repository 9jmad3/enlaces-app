---
import { socialLinks } from '../data/userData.js';
---
<div class="social">
  {
    socialLinks.map((icono) => (
      <a class="social__btn" href={icono.socialUl} target="_blank" rel="nofollow noreferrer noopener" data-astro-prefetch>
        <iconify-icon icon={icono.socialIcon} width="25" height="25" class="iconify" />
        <span>{icono.socialName}</span>
      </a>
    ))
  }
</div>
<style>
  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 320px;
    margin-top: 18px;
    gap: 1.4rem;
  }

  .social__btn {
    display: flex;
    align-items: center;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: var(--text-highligth);
    min-height: 48px;
    gap: 10px;
  }

  .iconify {
    color: var(--button-flat);
    transition: color 0.4s ease;
  }

  .iconify:hover {
    color: var(--button-hover);
  }

  :global(.dark) .iconify {
    color: var(--text-highligth);
  }

  :global(.dark) .social__btn {
    color: var(--text-highligth);
  }

  @media screen and (min-width: 768px) {
    span {
      display: none;
    }

    .social__btn:hover span {
      display: block;
      padding: 0.3rem 8px;
      background: #00000075;
      min-width: 37px;
      text-align: center;
      position: absolute;
      top: 76%;
      color: white;
      font-size: 1.2rem;
      font-weight: 500;
      border-radius: 7px;
      z-index: 20;
    }

    .social__btn:hover span::before {
      content: '';
      position: absolute;
      bottom: 100%;
      left: 50%;
      border-width: 5px;
      border-style: solid;
      border-color: transparent transparent #00000075 transparent;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .social {
      gap: 1rem;
    }
  }
</style>
