---
import LinkIcon from './LinkIcon.astro';
import LegalFooter from './LegalFooter.astro';
import { getSpotifyEmbedUrl, getYouTubeEmbedUrl } from '../lib/media.js';

interface ProfileLink {
  id: string;
  title: string;
  url: string;
  enabled: boolean;
  position: number;
}

interface Profile {
  id: string;
  user_id?: string;
  slug: string;
  display_name: string;
  tagline: string;
  bio: string;
  avatar_url: string;
  avatar_position_x: number;
  avatar_position_y: number;
  template_id: 'studio' | 'pulse' | 'aura' | 'frame';
  background_color: string;
  accent_color: string;
  text_color: string;
  spotify_url?: string;
  spotify_enabled?: boolean;
  youtube_url?: string;
  youtube_enabled?: boolean;
  links: ProfileLink[];
}

interface Props {
  profile: Profile;
}

const { profile }: Props = Astro.props;
const isPulse = profile.template_id === 'pulse';
const isAura = profile.template_id === 'aura';
const isFrame = profile.template_id === 'frame';
const isOwner = Astro.locals.user?.id === profile.user_id;
const canReport = !isOwner && !profile.id.startsWith('fallback-');
const reported = Astro.url.searchParams.has('reported');
const reportError = Astro.url.searchParams.has('reportError');
const reportLimited = Astro.url.searchParams.has('reportLimited');
const spotifyEmbedUrl = profile.spotify_enabled ? getSpotifyEmbedUrl(profile.spotify_url) : '';
const youtubeEmbedUrl = profile.youtube_enabled ? getYouTubeEmbedUrl(profile.youtube_url) : '';
const initials = profile.display_name
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
const style = `--profile-bg:${profile.background_color};--profile-accent:${profile.accent_color};--profile-text:${profile.text_color};--avatar-x:${profile.avatar_position_x ?? 50}%;--avatar-y:${profile.avatar_position_y ?? 20}%`;
---

<main class:list={[
  'profile-page',
  {
    'profile-page--pulse': isPulse,
    'profile-page--aura': isAura,
    'profile-page--frame': isFrame,
  },
]} style={style}>
  {reported && <p class="report-notice report-notice--success" role="status">Denuncia recibida. Gracias por ayudarnos a cuidar Trazli.</p>}
  {reportError && <p class="report-notice" role="alert">No hemos podido enviar la denuncia. Revisa los datos e inténtalo de nuevo.</p>}
  {reportLimited && <p class="report-notice" role="alert">Has alcanzado el límite de denuncias. Puedes escribir a hola@trazli.com si es urgente.</p>}

  <button class="share" type="button" aria-label="Compartir esta página">
    <span>Compartir</span><b aria-hidden="true">↗</b>
  </button>

  <section class="profile-card">
    <div class="profile-card__decor" aria-hidden="true"></div>
    <header>
      {profile.avatar_url ? (
        <img src={profile.avatar_url} alt={`Foto de ${profile.display_name}`} />
      ) : (
        <div class="avatar-fallback" aria-hidden="true">{initials}</div>
      )}
      <div class="identity">
        <p class="handle">@{profile.slug}</p>
        <h1>{profile.display_name}</h1>
        {profile.tagline && <p class="tagline">{profile.tagline}</p>}
      </div>
    </header>

    {profile.bio && <p class="bio">{profile.bio}</p>}

    {(spotifyEmbedUrl || youtubeEmbedUrl) && (
      <section class="profile-media" aria-label={`Contenido multimedia de ${profile.display_name}`}>
        {spotifyEmbedUrl && (
          <article class="media-card media-card--spotify" data-media-container>
            <button
              type="button"
              data-media-load
              data-embed-src={spotifyEmbedUrl}
              data-embed-title={`Canción de Spotify de ${profile.display_name}`}
              data-embed-platform="spotify"
            >
              <span class="media-mark" aria-hidden="true">♫</span>
              <span><small>Spotify · contenido externo</small><strong>Escuchar canción</strong></span>
              <i aria-hidden="true">▶</i>
            </button>
            <noscript><a href={profile.spotify_url} target="_blank" rel="nofollow noopener noreferrer">Abrir canción en Spotify</a></noscript>
          </article>
        )}
        {youtubeEmbedUrl && (
          <article class="media-card media-card--youtube" data-media-container>
            <button
              type="button"
              data-media-load
              data-embed-src={youtubeEmbedUrl}
              data-embed-title={`Vídeo de YouTube de ${profile.display_name}`}
              data-embed-platform="youtube"
            >
              <span class="media-mark" aria-hidden="true">▶</span>
              <span><small>YouTube · contenido externo</small><strong>Ver vídeo</strong></span>
              <i aria-hidden="true">▶</i>
            </button>
            <noscript><a href={profile.youtube_url} target="_blank" rel="nofollow noopener noreferrer">Abrir vídeo en YouTube</a></noscript>
          </article>
        )}
      </section>
    )}

    <nav class="profile-links" aria-label={`Enlaces de ${profile.display_name}`}>
      {profile.links.map((link) => (
        <a href={link.url} target="_blank" rel="nofollow noopener noreferrer">
          <LinkIcon title={link.title} url={link.url} />
          <strong>{link.title}</strong>
          <span class="link-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </section>

  <footer class="profile-footer">
    <a class="made-with" href="/"><span>T</span> Hecho con Trazli</a>
    <div>
      <a href="/registro">Crea el tuyo</a>
      {canReport && <button class="report-trigger" type="button" data-report-open>Denunciar este perfil</button>}
    </div>
  </footer>
  <LegalFooter compact />

  {canReport && (
    <dialog class="report-dialog" data-report-dialog aria-labelledby="report-title">
      <form class="report-dialog__card" action="/api/reports" method="post">
        <div class="report-dialog__heading">
          <div>
            <p>Seguridad</p>
            <h2 id="report-title">Denunciar @{profile.slug}</h2>
          </div>
          <button class="report-dialog__close" type="button" data-report-close aria-label="Cerrar">×</button>
        </div>
        <p class="report-dialog__intro">
          Revisa la información antes de enviarla. No comunicaremos tu identidad al propietario.
        </p>
        <input type="hidden" name="slug" value={profile.slug} />
        <label>
          Motivo
          <select name="reason" required>
            <option value="">Selecciona un motivo</option>
            <option value="impersonation">Suplantación de identidad</option>
            <option value="fraud">Fraude o estafa</option>
            <option value="illegal">Contenido ilegal</option>
            <option value="harassment">Acoso o amenazas</option>
            <option value="spam">Spam o contenido engañoso</option>
            <option value="other">Otro motivo</option>
          </select>
        </label>
        <label>
          Detalles
          <textarea name="details" maxlength="1000" placeholder="Cuéntanos qué has observado. Si eliges «Otro», incluye al menos 10 caracteres."></textarea>
        </label>
        <label>
          Tu correo <span>(opcional)</span>
          <input name="email" type="email" maxlength="254" autocomplete="email" placeholder="Para contactarte si necesitamos información" />
        </label>
        <p class="report-dialog__email-note">
          Si lo facilitas, recibirás un acuse y la resolución final de la revisión.
        </p>
        <label class="report-honeypot" aria-hidden="true">
          Sitio web
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <small>
          Usaremos estos datos únicamente para revisar el caso, según nuestra
          <a href="/privacidad">política de privacidad</a>.
        </small>
        <button class="report-submit" type="submit">Enviar denuncia</button>
      </form>
    </dialog>
  )}
</main>

<script>
  const shareButton = document.querySelector('.share');
  shareButton?.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: window.location.href });
      } else {
        await navigator.clipboard.writeText(window.location.href);
        const label = shareButton.querySelector('span');
        if (label) {
          label.textContent = 'Enlace copiado';
          window.setTimeout(() => { label.textContent = 'Compartir'; }, 1800);
        }
      }
    } catch {
      // El usuario puede cancelar el dialogo de compartir.
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-media-load]').forEach((button) => {
    button.addEventListener('click', () => {
      const container = button.closest<HTMLElement>('[data-media-container]');
      const source = button.dataset.embedSrc;
      if (!container || !source) return;

      const iframe = document.createElement('iframe');
      iframe.src = source;
      iframe.title = button.dataset.embedTitle || 'Reproductor multimedia';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.allow = button.dataset.embedPlatform === 'spotify'
        ? 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'
        : 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      container.replaceChildren(iframe);
    }, { once: true });
  });

  const reportDialog = document.querySelector<HTMLDialogElement>('[data-report-dialog]');
  document.querySelector('[data-report-open]')?.addEventListener('click', () => {
    reportDialog?.showModal();
  });
  document.querySelector('[data-report-close]')?.addEventListener('click', () => {
    reportDialog?.close();
  });
  reportDialog?.addEventListener('click', (event) => {
    if (event.target === reportDialog) reportDialog.close();
  });
</script>

<style>
  .profile-page {
    --soft-contrast: color-mix(in srgb, var(--profile-text) 12%, transparent);
    position: relative;
    display: flex;
    min-height: 100dvh;
    overflow: hidden;
    padding: 4.5rem 1rem 1.2rem;
    flex-direction: column;
    background:
      linear-gradient(var(--soft-contrast) 1px, transparent 1px),
      linear-gradient(90deg, var(--soft-contrast) 1px, transparent 1px),
      var(--profile-bg);
    background-size: 38px 38px;
    color: var(--profile-text);
  }
  .share {
    position: absolute;
    z-index: 4;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--soft-contrast);
    border-radius: 999px;
    background: color-mix(in srgb, var(--profile-bg) 86%, white);
    color: var(--profile-text);
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
  }
  .share b { color: var(--profile-accent); font-size: 1rem; }
  .report-notice {
    position: relative;
    z-index: 5;
    width: min(100%, 540px);
    margin: -2.7rem auto 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, #b23724 40%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, #fff0ec 94%, var(--profile-bg));
    color: #7f281a;
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .report-notice--success {
    border-color: color-mix(in srgb, #207354 35%, transparent);
    background: color-mix(in srgb, #e4f5ee 94%, var(--profile-bg));
    color: #185b44;
  }
  .profile-card {
    position: relative;
    z-index: 2;
    width: min(100%, 540px);
    margin: auto;
    padding: clamp(1.1rem, 4vw, 2rem);
  }
  .profile-card__decor {
    position: absolute;
    z-index: -1;
    top: -5rem;
    right: -7rem;
    width: 18rem;
    height: 18rem;
    border: 2.5rem solid var(--profile-accent);
    border-radius: 50%;
    opacity: 0.16;
  }
  header { display: flex; align-items: flex-end; gap: 1.2rem; }
  header img, .avatar-fallback {
    width: clamp(6rem, 22vw, 8rem);
    height: clamp(7rem, 25vw, 9.5rem);
    flex: 0 0 auto;
    border: 4px solid color-mix(in srgb, var(--profile-bg) 75%, white);
    border-radius: 1.5rem 1.5rem 1.5rem 0.35rem;
    box-shadow: 0 18px 40px color-mix(in srgb, var(--profile-text) 18%, transparent);
    object-fit: cover;
    object-position: var(--avatar-x) var(--avatar-y);
  }
  .avatar-fallback {
    display: grid;
    place-items: center;
    background: var(--profile-accent);
    color: var(--profile-bg);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 650;
  }
  .identity { min-width: 0; padding-bottom: 0.35rem; }
  .handle {
    margin: 0 0 0.35rem;
    color: var(--profile-accent);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 12vw, 4.7rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 0.82;
  }
  .tagline { margin: 0.65rem 0 0; font-size: 0.82rem; font-weight: 700; line-height: 1.4; }
  .bio {
    margin: 1.8rem 0;
    color: color-mix(in srgb, var(--profile-text) 72%, transparent);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .profile-media { display: grid; margin: 1.4rem 0; gap: 0.72rem; }
  .media-card {
    overflow: hidden;
    border: 1px solid var(--soft-contrast);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--profile-bg) 84%, white);
    box-shadow: 0 9px 22px color-mix(in srgb, var(--profile-text) 6%, transparent);
  }
  .media-card button {
    display: grid;
    width: 100%;
    min-height: 4.3rem;
    padding: 0.7rem 0.85rem;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    border: 0;
    background: transparent;
    color: var(--profile-text);
    text-align: left;
    cursor: pointer;
  }
  .media-card button > span:nth-child(2) { display: grid; gap: 0.12rem; }
  .media-card small { color: color-mix(in srgb, var(--profile-text) 58%, transparent); font-size: 0.58rem; font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; }
  .media-card strong { font-size: 0.86rem; }
  .media-card button > i { font-size: 0.72rem; font-style: normal; }
  .media-mark {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border-radius: 50%;
    color: white;
    font-size: 1rem;
    font-weight: 900;
  }
  .media-card--spotify .media-mark { background: #1ed760; color: #092b16; }
  .media-card--youtube .media-mark { border-radius: 0.75rem; background: #ff0033; }
  .media-card iframe { display: block; width: 100%; border: 0; background: #101010; }
  .media-card--spotify iframe { height: 152px; }
  .media-card--youtube iframe { aspect-ratio: 16 / 9; }
  .media-card noscript a { display: block; padding: 0.8rem; color: inherit; }
  .profile-links { display: grid; gap: 0.72rem; }
  .profile-links a {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    min-height: 4.3rem;
    padding: 0.8rem 1rem;
    align-items: center;
    border: 1px solid var(--soft-contrast);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--profile-bg) 84%, white);
    color: var(--profile-text);
    box-shadow: 0 9px 22px color-mix(in srgb, var(--profile-text) 6%, transparent);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .profile-links a:hover {
    transform: translateY(-2px) rotate(-0.3deg);
    box-shadow: 0 14px 28px color-mix(in srgb, var(--profile-text) 11%, transparent);
  }
  .profile-links strong { overflow-wrap: anywhere; font-size: 0.92rem; }
  .link-arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--profile-accent);
    color: var(--profile-bg);
    font-weight: 850;
  }
  .profile-footer {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(100%, 540px);
    margin: 2rem auto 0;
    padding-top: 1rem;
    justify-content: space-between;
    border-top: 1px solid var(--soft-contrast);
    color: color-mix(in srgb, var(--profile-text) 65%, transparent);
    font-size: 0.68rem;
  }
  :global(.profile-page > .legal-footer) {
    position: relative;
    z-index: 2;
    width: min(100%, 540px);
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--profile-text) 62%, transparent);
  }
  .profile-footer a { text-underline-offset: 0.2rem; }
  .profile-footer > div { display: flex; gap: 0.8rem; }
  .report-trigger {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
    cursor: pointer;
  }
  .made-with { display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none; font-weight: 750; }
  .made-with span {
    display: grid;
    width: 1.4rem;
    height: 1.4rem;
    place-items: center;
    border-radius: 0.4rem;
    background: var(--profile-text);
    color: var(--profile-bg);
    font-family: var(--font-display);
    font-size: 0.75rem;
  }
  .report-dialog {
    width: min(92vw, 500px);
    max-height: min(90dvh, 720px);
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 1.25rem;
    background: #fffdf8;
    color: #17201d;
    box-shadow: 0 30px 90px rgba(14, 20, 18, 0.35);
  }
  .report-dialog::backdrop { background: rgba(14, 20, 18, 0.62); backdrop-filter: blur(4px); }
  .report-dialog__card { display: grid; padding: clamp(1.1rem, 5vw, 1.8rem); gap: 0.9rem; }
  .report-dialog__heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .report-dialog__heading p {
    margin: 0 0 0.3rem;
    color: #e45136;
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .report-dialog h2 { margin: 0; font-family: var(--font-display); font-size: 1.8rem; line-height: 1; }
  .report-dialog__close {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid #d8d4ca;
    border-radius: 50%;
    background: transparent;
    color: #17201d;
    font-size: 1.35rem;
    cursor: pointer;
  }
  .report-dialog__intro { margin: 0; color: #64706b; font-size: 0.75rem; line-height: 1.55; }
  .report-dialog__email-note { margin: -0.55rem 0 0; color: #69736f; font-size: 0.65rem; line-height: 1.45; }
  .report-dialog label { display: grid; gap: 0.35rem; font-size: 0.72rem; font-weight: 800; }
  .report-dialog label > span { color: #7a837f; font-weight: 500; }
  .report-dialog input, .report-dialog select, .report-dialog textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid #d8d4ca;
    border-radius: 0.7rem;
    background: white;
    color: #17201d;
    font: inherit;
  }
  .report-dialog textarea { min-height: 6.5rem; resize: vertical; }
  .report-dialog small { color: #69736f; font-size: 0.65rem; line-height: 1.5; }
  .report-dialog small a { color: inherit; }
  .report-submit {
    min-height: 3rem;
    border: 0;
    border-radius: 0.7rem;
    background: #17201d;
    color: white;
    font-weight: 850;
    cursor: pointer;
  }
  .report-honeypot { position: absolute !important; left: -10000px !important; }
  .profile-page--pulse {
    background:
      radial-gradient(circle at 0 0, var(--profile-accent) 0 17%, transparent 17.2%),
      radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--profile-accent) 60%, white) 0 15%, transparent 15.2%),
      var(--profile-bg);
  }
  .profile-page--pulse .profile-card { padding-top: 2.5rem; }
  .profile-page--pulse .profile-card__decor {
    top: -3rem;
    right: auto;
    left: -4rem;
    width: 10rem;
    height: 10rem;
    border: 0;
    border-radius: 1.5rem;
    background: var(--profile-accent);
    opacity: 0.2;
    transform: rotate(22deg);
  }
  .profile-page--pulse header { align-items: center; flex-direction: column; text-align: center; }
  .profile-page--pulse header img, .profile-page--pulse .avatar-fallback {
    width: 9rem;
    height: 9rem;
    border: 6px solid var(--profile-text);
    border-radius: 50%;
    box-shadow: 10px 10px 0 var(--profile-accent);
  }
  .profile-page--pulse h1 {
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: clamp(2.3rem, 10vw, 3.5rem);
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .profile-page--pulse .bio { text-align: center; }
  .profile-page--pulse .profile-links a {
    min-height: 4.6rem;
    border: 3px solid var(--profile-text);
    border-radius: 0;
    background: var(--profile-accent);
    box-shadow: 6px 6px 0 var(--profile-text);
  }
  .profile-page--pulse .media-card {
    border: 2px solid var(--profile-text);
    border-radius: 0;
    background: var(--profile-accent);
    box-shadow: 4px 4px 0 var(--profile-text);
  }
  .profile-page--pulse .profile-links a:nth-child(even) {
    background: color-mix(in srgb, var(--profile-bg) 82%, white);
  }
  .profile-page--pulse .link-number { color: var(--profile-text); }
  .profile-page--pulse .link-arrow { background: var(--profile-text); color: var(--profile-bg); }

  .profile-page--aura {
    background:
      radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--profile-accent) 42%, transparent) 0 10rem, transparent 23rem),
      radial-gradient(circle at 92% 72%, color-mix(in srgb, var(--profile-accent) 28%, white 10%) 0 8rem, transparent 22rem),
      linear-gradient(145deg, color-mix(in srgb, var(--profile-bg) 86%, white), var(--profile-bg));
  }
  .profile-page--aura::before {
    position: fixed;
    inset: 0;
    background: linear-gradient(115deg, transparent 20%, color-mix(in srgb, white 16%, transparent) 50%, transparent 78%);
    content: '';
    pointer-events: none;
  }
  .profile-page--aura .profile-card {
    margin-block: auto 1.5rem;
    padding: clamp(1.4rem, 6vw, 2.5rem);
    border: 1px solid color-mix(in srgb, white 55%, var(--profile-text) 10%);
    border-radius: 2.2rem;
