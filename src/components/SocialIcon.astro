---
interface Props {
  platform: 'instagram' | 'tiktok' | 'youtube';
}

const { platform }: Props = Astro.props;
---

<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
  {platform === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle class="fill" cx="17.4" cy="6.7" r="1"></circle>
    </>
  )}
  {platform === 'tiktok' && (
    <>
      <path d="M14 4v10.2a4.7 4.7 0 1 1-4-4.6"></path>
      <path d="M14 4c.5 2.5 2 4 4.5 4.5"></path>
    </>
  )}
  {platform === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect>
      <path class="fill" d="m10 9 5 3-5 3z"></path>
    </>
  )}
</svg>

<style>
  .social-icon {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
  .fill { fill: currentColor; stroke: none; }
</style>
