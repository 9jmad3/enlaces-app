---
interface Props {
  title: string;
  url: string;
}

const { title, url }: Props = Astro.props;
let platform = 'web';

try {
  const hostname = new URL(url).hostname.replace(/^www\./, '').toLowerCase();
  const label = title.toLowerCase();
  if (hostname.includes('instagram.com') || label.includes('instagram')) platform = 'instagram';
  else if (hostname.includes('tiktok.com') || label.includes('tiktok')) platform = 'tiktok';
  else if (hostname.includes('youtube.com') || hostname === 'youtu.be' || label.includes('youtube')) platform = 'youtube';
} catch {
  platform = 'web';
}
---

<span class="link-icon" aria-hidden="true">
  {platform === 'instagram' && (
    <svg viewBox="0 0 24 24">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle class="fill" cx="17.4" cy="6.7" r="1"></circle>
    </svg>
  )}
  {platform === 'tiktok' && (
    <svg viewBox="0 0 24 24">
      <path d="M14 4v10.2a4.7 4.7 0 1 1-4-4.6"></path>
      <path d="M14 4c.5 2.5 2 4 4.5 4.5"></path>
    </svg>
  )}
  {platform === 'youtube' && (
    <svg viewBox="0 0 24 24">
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect>
      <path class="fill" d="m10 9 5 3-5 3z"></path>
    </svg>
  )}
  {platform === 'web' && (
    <svg viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3.5 12h17M12 3c2.5 2.6 3.7 5.6 3.7 9S14.5 18.4 12 21M12 3C9.5 5.6 8.3 8.6 8.3 12s1.2 6.4 3.7 9"></path>
    </svg>
  )}
</span>

<style>
  .link-icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 0.72rem;
  }
  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
  .fill { fill: currentColor; stroke: none; }
</style>
